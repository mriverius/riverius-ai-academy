---
import { getCollection } from "astro:content";
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import HeroOpal from "../components/HeroOpal.astro";
import ClientMarks from "../components/ClientMarks.astro";
import PhaseVisual from "../components/PhaseVisual.astro";
import CaseCover from "../components/CaseCover.astro";
import CtaPanel from "../components/CtaPanel.astro";
import Words from "../components/Words.astro";
import Button from "../components/Button.astro";
import { phases, capabilities, solutions } from "../data/services";
import { team } from "../data/team";
import { site } from "../data/site";
import { faq } from "../data/faq";
import { faqPage, service } from "../lib/schema";

const cases = (await getCollection("work")).sort((a, b) => a.data.order - b.data.order);
const testimonial = cases.find((c) => c.data.quote)!;

const approach =
  "Every week brings a new AI tool. Choosing well takes more than knowing what's trending. We begin with your business: how work flows, where your people invest their time, and where AI creates a genuine edge.";

// Bento placement for the five capabilities (desktop). Mobile is a single column.
const bento = [
  "lg:col-span-4 lg:row-span-2",
  "lg:col-span-2",
  "lg:col-span-2",
  "lg:col-span-3",
  "lg:col-span-3",
];

// Founders, architect first to match the headline.
const founders = ["Mariano Rivera", "Aaisha Ali"].map((name) => team.find((p) => p.name === name)!);

const trust = [
  { title: "Yours to keep.", text: "You own everything we build: the systems, the code and the data.", icon: "ph:key-light" },
  { title: "Privacy by design.", text: "We agree up front where your data lives and who can access it, and we work under NDA.", icon: "ph:shield-check-light" },
  { title: "Senior oversight on every build.", text: "Each project is architected and reviewed by our lead engineer.", icon: "ph:compass-tool-light" },
  { title: "A global perspective.", text: "We've delivered for clients across North America, Latin America, the Middle East and Australia.", icon: "ph:globe-hemisphere-west-light" },
];

const starts = [
  { title: "AI Audit & Roadmap", text: "A focused deep-dive into your business that reveals where AI creates the most value, delivered as a clear, prioritized roadmap.", icon: "ph:compass-light", recommended: true },
  { title: "Project build", text: "We design, engineer and launch a specific system, from a single agent to a full platform.", icon: "ph:cube-transparent-light" },
  { title: "Ongoing partnership", text: "Continuous support, optimization and new builds as your business evolves.", icon: "ph:infinity-light" },
  { title: "Workshops & AI education", text: "Live sessions that give leaders and teams the confidence to work with AI every day.", icon: "ph:chalkboard-teacher-light" },
];
---

<Base schema={[...solutions.map((s) => service({ name: s.name, description: `${s.lead} ${s.text}`, path: "/#solutions" })), faqPage(faq)]}>
  <HeroOpal />

  <!-- 2. Our approach: words light up with scroll -->
  <section class="px-4 py-28 sm:px-6 lg:px-10 lg:py-44">
    <div class="mx-auto max-w-5xl">
      <h2 class="display-lg max-w-[18ch]"><Words text="We design systems, not tool lists." /></h2>
      <p data-scrub class="mt-12 text-[1.75rem] font-semibold leading-[2.375rem] tracking-[-0.025em] sm:text-[2.75rem] sm:leading-[3.4rem]">
        {approach.split(" ").map((w) => <><span class="sw">{w}</span>{" "}</>)}
      </p>
      <p data-reveal class="mt-10 max-w-[58ch] text-[1.0625rem] leading-[1.75rem] text-cosmos-muted">
        Then we architect the systems that serve it, with the same precision we bring to the build. The result is AI that fits your business beautifully and grows with it.
      </p>
      <div data-reveal class="mt-14 flex flex-col gap-6 sm:flex-row sm:items-center sm:justify-between">
        <p class="text-subheading font-semibold">Critical thinking first. Technology second. Results always.</p>
        <Button href="/services" variant="ghost">How we work</Button>
      </div>
    </div>
  </section>

  <!-- 3. One team, start to finish: stacked cards -->
  <section id="approach" class="px-3 pb-24 sm:px-6 lg:px-10 lg:pb-40">
    <div class="mx-auto max-w-7xl">
      <div class="mb-14 max-w-3xl px-1 lg:mb-20">
        <h2 class="display-lg"><Words text="From first conversation to everyday confidence." /></h2>
        <p data-reveal class="mt-6 max-w-[54ch] text-cosmos-muted">Strategy, engineering and training, all carried by one team. Your vision stays whole from the first map to the moment your people run it with ease.</p>
      </div>

      <div data-stack class="flex flex-col gap-6 lg:gap-[12vh]">
        {
          phases.map((p, i) => (
            <article data-stack-card class="lg:sticky" style={`top: calc(6.5rem + ${i} * 1.75rem)`}>
              <div class="bezel origin-top will-change-transform">
                <div class="bezel-core is-pearl grid gap-8 p-6 sm:p-10 lg:grid-cols-[1.15fr_1fr] lg:items-center lg:gap-16 lg:p-14">
                  <div>
                    <div class="flex items-center gap-4">
                      <span class="inline-flex size-12 items-center justify-center rounded-full bg-nacre shadow-[inset_0_0_0_1px_var(--c-line)]">
                        <Icon name={p.icon} class="size-6" />
                      </span>
                      <h3 class="text-heading"><span class="text-cosmos-muted">0{i + 1}</span> {p.verb}</h3>
                    </div>
                    <p class="mt-8 text-[1.625rem] font-semibold leading-[2.125rem] tracking-[-0.02em] sm:text-[2rem] sm:leading-[2.5rem]">{p.headline}</p>
                    <p class="mt-4 max-w-[52ch] text-cosmos-muted">{p.summary}</p>
                    <ul class="mt-8 flex flex-wrap gap-2">
                      {p.deliverables.slice(0, 4).map((d) => (
                        <li class="rounded-full bg-nacre px-3.5 py-1.5 text-caption font-medium">{d}</li>
                      ))}
                    </ul>
                  </div>
                  <div class="pearl-sheen relative isolate mx-auto w-full max-w-[380px] overflow-hidden rounded-[var(--radius-lg)] bg-nacre p-6 sm:p-10">
                    <PhaseVisual kind={p.visual} />
                  </div>
                </div>
              </div>
            </article>
          ))
        }
      </div>
      <p data-reveal class="mt-14 px-1 text-subheading font-semibold lg:mt-20">One partner. One vision. Carried all the way through.</p>
    </div>
  </section>

  <!-- 4. What becomes possible: bento -->
  <section class="px-3 pb-24 sm:px-6 lg:px-10 lg:pb-40">
    <div class="mx-auto max-w-7xl">
      <div class="mb-12 max-w-3xl px-1 lg:mb-16">
        <h2 class="display-lg"><Words text="What your business can do next." /></h2>
      </div>

      <div class="grid gap-4 lg:grid-cols-6 lg:grid-rows-[repeat(3,minmax(15rem,auto))]">
        {
          capabilities.map((c, i) => (
            <div data-reveal style={`--i:${i}`} class:list={["bezel", bento[i]]}>
              <div
                class:list={[
                  "bezel-core spotlight flex h-full flex-col p-7 sm:p-9",
                  i === 0 && "!bg-ink text-shell",
                  i === 4 && "pearl-sheen",
                ]}
              >
                {i === 0 && (
                  <>
                    <div class="glow aurora -right-[15%] -top-[25%] -z-10 size-[80%] !opacity-50" />
                    <div class="cap-orb pointer-events-none absolute -right-[8%] -top-[22%] -z-10 aspect-square w-[52%] rounded-full" />
                  </>
                )}
                <span
                  class:list={[
                    "inline-flex size-12 items-center justify-center rounded-full",
                    i === 0 ? "bg-shell/10 shadow-[inset_0_0_0_1px_rgb(255_251_247/0.15)]" : "bg-pearl shadow-[inset_0_0_0_1px_var(--c-line)]",
                  ]}
                >
                  <Icon name={c.icon} class="size-6" />
                </span>
                <p class:list={["mt-auto pt-10 text-caption font-medium uppercase tracking-[0.12em]", i === 0 ? "text-haze" : "text-cosmos-muted"]}>{c.label}</p>
                <h3 class:list={["mt-3 font-semibold", i === 0 ? "display-lg max-w-[14ch]" : "text-heading"]}>{c.title}</h3>
                <p class:list={["mt-3 max-w-[42ch]", i === 0 ? "text-haze" : "text-cosmos-muted"]}>{c.text}</p>
              </div>
            </div>
          ))
        }
      </div>
      <p data-reveal class="mt-10 px-1 text-cosmos-muted">
        <span class="font-semibold text-cosmos">Have something bigger in mind?</span> If it runs your business, we can architect it.
      </p>
    </div>
  </section>

  <!-- 4b. Our solutions in depth -->
  <section id="solutions" class="scroll-mt-28 px-4 pb-24 sm:px-6 lg:px-10 lg:pb-40">
    <div class="mx-auto max-w-7xl">
      <div class="max-w-3xl">
        <h2 class="display-lg"><Words text="The AI solutions leading companies are investing in now." /></h2>
        <p data-reveal class="mt-6 max-w-[54ch] text-cosmos-muted">The fastest-growing areas of AI, designed around your business and built by our team.</p>
      </div>
      <div class="mt-14 border-t border-line lg:mt-20">
        {
          solutions.map((s) => (
            <details data-reveal class="solution group border-b border-line">
              <summary class="grid cursor-pointer list-none grid-cols-[auto_1fr_auto] items-center gap-x-5 gap-y-1 py-6 sm:gap-x-8 lg:grid-cols-[auto_0.9fr_1.4fr_auto] lg:py-8 [&::-webkit-details-marker]:hidden">
                <span class="inline-flex size-11 items-center justify-center rounded-full bg-nacre shadow-[inset_0_0_0_1px_var(--c-line)] sm:size-12">
                  <Icon name={s.icon} class="size-5 sm:size-6" />
                </span>
                <h3 class="text-subheading font-semibold sm:text-heading">{s.name}</h3>
                <p class="col-start-2 row-start-2 text-cosmos-muted lg:col-start-3 lg:row-start-1">{s.lead}</p>
                <span class="col-start-3 row-span-2 row-start-1 inline-flex size-9 items-center justify-center rounded-full shadow-[inset_0_0_0_1px_var(--c-line)] transition-transform duration-500 ease-[var(--ease-drawer)] group-open:rotate-45 lg:col-start-4 lg:row-span-1">
                  <Icon name="ph:plus-light" class="size-4" />
                </span>
              </summary>
              <div class="pb-8 pl-16 sm:pl-20 sm:pr-12 lg:grid lg:grid-cols-[0.9fr_1.4fr] lg:gap-x-8 lg:pl-20 lg:pr-[4.25rem]">
                <div class="lg:col-start-2">
                  <p class="max-w-[62ch] text-[1.0625rem] leading-[1.75rem]">{s.text}</p>
                  <p class="mt-4 text-cosmos-muted"><span class="font-medium text-cosmos">Ideal for:</span> {s.idealFor.join(", ")}.</p>
                </div>
              </div>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 5. Proof. Selected work: horizontal pan on desktop, swipe on mobile -->
  <section data-hpan class="hpan relative lg:flex lg:min-h-[100dvh] lg:items-center">
    <div
      data-hpan-track
      class="flex snap-x snap-mandatory gap-4 overflow-x-auto px-3 pb-6 [scrollbar-width:none] sm:px-6 lg:snap-none lg:px-10 lg:pb-0 [&::-webkit-scrollbar]:hidden"
    >
      <div class="flex w-[82vw] shrink-0 snap-start flex-col justify-end p-1 sm:w-[60vw] lg:w-[30vw] lg:pr-10">
        <h2 class="display-lg"><Words text="Results our clients celebrate." /></h2>
        <p data-reveal class="mt-5 max-w-[38ch] text-cosmos-muted">From the United States to Saudi Arabia, businesses are already running on systems we've built.</p>
        <a href="/work" class="group mt-8 inline-flex items-center gap-2 font-medium">
          Explore our work
          <Icon name="ph:arrow-right-light" class="size-5 transition-transform duration-500 ease-[var(--ease-drawer)] group-hover:translate-x-1" />
        </a>
      </div>

      {
        cases.map((c) => (
          <a href={`/work/${c.id}`} class="group bezel w-[82vw] shrink-0 snap-start sm:w-[60vw] lg:w-[46vw]">
            <div class="bezel-core is-pearl flex h-full flex-col p-3">
              <CaseCover tone={c.data.tone} cover={c.data.cover} fit={c.data.coverFit} class="aspect-[16/10]" />
              <div class="flex flex-1 flex-col p-5 sm:p-7">
                <p class="text-caption text-cosmos-muted">{[c.data.client, c.data.country].filter(Boolean).join(", ")}</p>
                <h3 class="mt-2 text-heading">{c.data.title}</h3>
                <dl class="mt-auto grid grid-cols-2 gap-6 pt-8">
                  {c.data.results.slice(0, 2).map((r) => (
                    <div>
                      <dt class="sr-only">{r.label}</dt>
                      <dd class="text-[2rem] font-semibold leading-none tracking-[-0.03em] sm:text-[2.5rem]">{r.value}</dd>
                      <dd class="mt-2 text-caption text-cosmos-muted">{r.label}</dd>
                    </div>
                  ))}
                </dl>
              </div>
            </div>
          </a>
        ))
      }
      <div class="w-px shrink-0 lg:w-[4vw]" aria-hidden="true"></div>
    </div>
  </section>

  <!-- Testimonial -->
  {
    testimonial.data.quote && (
      <section class="px-4 py-28 sm:px-6 lg:px-10 lg:py-44">
        <figure class="mx-auto max-w-4xl text-center">
          <svg data-reveal viewBox="0 0 24 24" class="mx-auto size-7" aria-hidden="true">
            <path fill="currentColor" d="M12 0C12.8 7 17 11.2 24 12C17 12.8 12.8 17 12 24C11.2 17 7 12.8 0 12C7 11.2 11.2 7 12 0Z" />
          </svg>
          <blockquote class="display-lg mt-10 !text-[clamp(1.75rem,3.6vw,3rem)]">
            <Words text={`“${testimonial.data.quote.short ?? testimonial.data.quote.text}”`} />
          </blockquote>
          <figcaption data-reveal style="--i:4" class="mt-10">
            <span class="block font-medium">{testimonial.data.quote.name}</span>
            <span class="text-caption text-cosmos-muted">{testimonial.data.quote.role}</span>
          </figcaption>
        </figure>
        <div class="mx-auto mt-24 max-w-7xl lg:mt-32">
          <ClientMarks />
        </div>
      </section>
    )
  }

  <!-- 6. The founders -->
  <section class="px-3 pb-24 sm:px-6 lg:px-10 lg:pb-40">
    <div class="mx-auto max-w-7xl">
      <div class="max-w-3xl px-1">
        <h2 class="display-lg"><Words text="The architect and the visionary." /></h2>
        <p data-reveal class="mt-6 max-w-[58ch] text-cosmos-muted">Riverius brings together two rare strengths: the engineering mind that designs systems, and the creative, business mind that shapes how they look, feel and grow.</p>
      </div>
      <div class="mt-14 grid gap-4 lg:mt-20 lg:grid-cols-2">
        {
          founders.map((p, i) => (
            <article data-reveal style={`--i:${i}`} class="bezel">
              <div class:list={["bezel-core is-pearl flex h-full flex-col p-7 sm:p-10", i === 0 && "pearl-sheen"]}>
                <div class="flex items-center gap-5">
                  <Image src={p.photo} alt={`${p.name}, ${p.role}`} widths={[96, 192]} sizes="96px" class="size-20 rounded-full object-cover sm:size-24" />
                  <div>
                    <h3 class="text-heading">{p.name}</h3>
                    <p class="mt-1 text-cosmos-muted">{p.role}</p>
                  </div>
                </div>
                <div class="mt-8 space-y-4 text-cosmos-muted">
                  {p.bio.map((para) => <p>{para}</p>)}
                </div>
              </div>
            </article>
          ))
        }
      </div>
      <div data-reveal class="mt-10 flex flex-col gap-6 px-1 sm:flex-row sm:items-center sm:justify-between">
        <p class="max-w-[56ch] text-cosmos-muted">Senior engineering led by Mariano, with a trusted bench of developers who scale with the size of your project.</p>
        <Button href="/team" variant="ghost">Meet the team</Button>
      </div>
    </div>
  </section>

  <!-- 7. Built on trust -->
  <section class="px-3 pb-24 sm:px-6 lg:px-10 lg:pb-40">
    <div class="mx-auto max-w-7xl">
      <div class="max-w-3xl px-1">
        <h2 class="display-lg"><Words text="A partnership designed for peace of mind." /></h2>
      </div>
      <ul class="mt-14 grid gap-x-10 gap-y-12 px-1 sm:grid-cols-2 lg:mt-20 lg:grid-cols-4">
        {
          trust.map((t, i) => (
            <li data-reveal style={`--i:${i}`} class="border-t border-line pt-8">
              <Icon name={t.icon} class="size-7" />
              <h3 class="mt-6 text-subheading font-semibold">{t.title}</h3>
              <p class="mt-3 text-cosmos-muted">{t.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- 8. How to begin -->
  <section id="begin" class="scroll-mt-28 px-3 pb-24 sm:px-6 lg:px-10 lg:pb-40">
    <div class="mx-auto max-w-7xl">
      <div class="max-w-3xl px-1">
        <h2 class="display-lg"><Words text="Choose your starting point." /></h2>
      </div>
      <div class="mt-14 grid gap-4 sm:grid-cols-2 lg:mt-20 lg:grid-cols-4">
        {
          starts.map((o, i) => (
            <div data-reveal style={`--i:${i}`} class="bezel">
              <div class:list={["bezel-core spotlight flex h-full flex-col p-7", o.recommended ? "!bg-ink text-shell" : "is-pearl"]}>
                {o.recommended && <div class="glow aurora -right-[30%] -top-[30%] -z-10 size-[90%] !opacity-40" />}
                <span
                  class:list={[
                    "inline-flex size-12 items-center justify-center rounded-full",
                    o.recommended ? "bg-shell/10 shadow-[inset_0_0_0_1px_rgb(255_251_247/0.15)]" : "bg-nacre shadow-[inset_0_0_0_1px_var(--c-line)]",
                  ]}
                >
                  <Icon name={o.icon} class="size-6" />
                </span>
                {o.recommended && <p class="mt-8 text-caption font-medium uppercase tracking-[0.12em] text-haze">Recommended first step</p>}
                <h3 class:list={["text-subheading font-semibold", o.recommended ? "mt-2" : "mt-8"]}>{o.title}</h3>
                <p class:list={["mt-3", o.recommended ? "text-haze" : "text-cosmos-muted"]}>{o.text}</p>
                {o.recommended && (
                  <div class="mt-auto pt-8">
                    <Button href={site.cta.href} variant="glow">Start with an AI Audit</Button>
                  </div>
                )}
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section id="faq" class="scroll-mt-28 px-4 sm:px-6 lg:px-10">
    <div class="mx-auto grid max-w-7xl gap-12 lg:grid-cols-[1fr_1.4fr] lg:gap-20">
      <div class="lg:sticky lg:top-32 lg:self-start">
        <h2 class="display-lg"><Words text="Questions we hear often." /></h2>
      </div>
      <div class="space-y-3">
        {
          faq.map((item, i) => (
            <details data-reveal style={`--i:${i}`} class="faq group bezel !rounded-[calc(var(--radius-md)+6px)]">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-6 rounded-[var(--radius-md)] bg-nacre px-6 py-5 font-medium group-open:rounded-b-none [&::-webkit-details-marker]:hidden">
                {item.q}
                <span class="inline-flex size-8 shrink-0 items-center justify-center rounded-full bg-pearl transition-transform duration-500 ease-[var(--ease-drawer)] group-open:rotate-45">
                  <Icon name="ph:plus-light" class="size-4" />
                </span>
              </summary>
              <p class="rounded-b-[var(--radius-md)] bg-nacre px-6 pb-6 text-cosmos-muted">{item.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 9. Closing -->
  <CtaPanel
    title="Your next chapter with AI starts *here.*"
    text="Book a 30-minute discovery call. We'll explore how your business runs, where AI can elevate it, and what your roadmap could look like."
  />
</Base>

<style>
  /* When GSAP pins the gallery, the track moves instead of scrolling. */
  .hpan:global(.is-pinned) {
    overflow: hidden;
  }
  .hpan:global(.is-pinned) [data-hpan-track] {
    width: max-content;
    overflow: visible;
  }
  .cap-orb {
    background:
      radial-gradient(circle at 34% 28%, rgb(255 251 247 / 0.95) 0 5%, rgb(255 251 247 / 0.4) 16%, transparent 34%),
      radial-gradient(circle at 25% 70%, #8fd3ff, transparent 55%),
      radial-gradient(circle at 75% 30%, #ff9ed2, transparent 55%),
      radial-gradient(circle at 70% 80%, #c3a8ff, transparent 60%),
      #e9ddff;
    box-shadow:
      inset 0 0 0 1px rgb(255 251 247 / 0.5),
      inset -30px -40px 80px rgb(30 22 56 / 0.25),
      0 0 80px 10px rgb(195 168 255 / 0.35);
  }
  @media (prefers-reduced-motion: no-preference) {
    .cap-orb {
      animation: cap-spin 30s linear infinite;
    }
  }
  @keyframes cap-spin {
    to {
      rotate: 360deg;
    }
  }
</style>
