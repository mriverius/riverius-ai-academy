---
// Public certificate page, reachable only by its unguessable link: the student shares it and adds it to LinkedIn.
import { Icon } from "astro-icon/components";
import Academy from "../../../layouts/Academy.astro";
import VideoFacade from "../../../components/academy/VideoFacade.astro";
import { certificates, courses, issuer, certificatePath, issuedLabel, linkedinAddUrl } from "../../../data/certificates";

export const getStaticPaths = () => certificates.map((c) => ({ params: { id: c.id }, props: { cert: c } }));

const { cert } = Astro.props;
const course = courses[cert.course];
const url = new URL(certificatePath(cert.id), Astro.site).href;
const date = issuedLabel(cert.issued);
const shareUrl = `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(url)}`;
---

<Academy
  title={`Certificado de ${cert.student}`}
  description={`${cert.student} completó ${course.name} en Riverius AI Academy (${course.hours} horas).`}
  noindex
>
  <!-- Hero: who earned it, then the certificate, large. -->
  <section class="relative isolate overflow-x-clip px-3 pb-16 pt-32 sm:px-6 lg:px-10 lg:pt-40">
    <div class="glow sunrise left-1/2 top-[38%] -z-10 size-[min(90vw,60rem)] -translate-x-1/2 !opacity-25" aria-hidden="true"></div>
    <div class="mx-auto max-w-3xl text-center">
      <p class="inline-flex items-center gap-2 rounded-full bg-pearl/70 px-3.5 py-1.5 text-caption font-medium shadow-[inset_0_0_0_1px_var(--c-line)]">
        <span class="inline-flex size-4 items-center justify-center rounded-full bg-jade text-ink"><Icon name="ph:check-bold" class="size-2.5" /></span>
        Certificado verificado
      </p>
      <h1 class="display-lg mx-auto mt-6 max-w-[18ch]">{cert.student}</h1>
      <p class="mx-auto mt-5 max-w-[52ch] text-[1.0625rem] leading-[1.75rem] text-cosmos-muted">
        Completó <span class="font-medium text-cosmos">{course.name}</span> en Riverius AI Academy · {date} · {course.hours} horas
      </p>
    </div>

    <!-- The certificate. Sized in container units, so it scales like an image. -->
    <div class="cert-wrap mx-auto mt-12 max-w-6xl lg:mt-16">
        <article class="cert" aria-label={`Certificado de finalización de ${cert.student}`}>
          <div class="cert-orb orb-a" aria-hidden="true"></div>
          <div class="cert-orb orb-b" aria-hidden="true"></div>
          <div class="cert-orb orb-c" aria-hidden="true"></div>
          <div class="cert-inner">
            <p class="cert-brand">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 0C12.8 7 17 11.2 24 12C17 12.8 12.8 17 12 24C11.2 17 7 12.8 0 12C7 11.2 11.2 7 12 0Z"></path></svg>
              Riverius <span>AI Academy</span>
            </p>
            <p class="cert-title">Certificado</p>
            <p class="cert-subtitle">de finalización</p>
            <p class="cert-kicker">Se otorga el presente certificado a</p>
            <p class="cert-name">{cert.student}</p>
            <p class="cert-body">
              Por haber completado satisfactoriamente el curso <strong>{course.name}</strong>. {course.proof} {course.outcome}
            </p>
            <p class="cert-meta">Emitido el {date} · Duración: {course.hours} horas</p>

            <div class="cert-footer">
              <div class="cert-sign">
                <p class="cert-signature">Mariano Rivera</p>
                <p class="cert-sign-name">{issuer.name}</p>
                <p class="cert-sign-title">{issuer.title}</p>
              </div>
              <div class="cert-seal" aria-hidden="true">
                <svg viewBox="0 0 24 24"><path fill="currentColor" d="M12 0C12.8 7 17 11.2 24 12C17 12.8 12.8 17 12 24C11.2 17 7 12.8 0 12C7 11.2 11.2 7 12 0Z"></path></svg>
              </div>
              <div class="cert-id">
                <p>ID del certificado</p>
                <p class="cert-id-value">{cert.id}</p>
                <p>Verificable en riverius.ai</p>
              </div>
            </div>
          </div>
        </article>
    </div>

    <div class="no-print mx-auto mt-10 flex max-w-6xl flex-wrap items-center justify-center gap-3">
      <a href={linkedinAddUrl(cert, url)} target="_blank" rel="noopener" class="btn btn-primary group" data-magnetic>
        Agregar a mi perfil de LinkedIn
        <span class="btn-island" aria-hidden="true"><Icon name="ph:linkedin-logo-light" class="size-4" /></span>
      </a>
      <a href={shareUrl} target="_blank" rel="noopener" class="btn btn-ghost btn-plain">Compartir</a>
      <button type="button" id="print-cert" class="btn btn-ghost btn-plain">Descargar PDF</button>
      <button type="button" id="copy-cert" data-url={url} class="btn btn-ghost btn-plain"><span data-copy-label>Copiar enlace</span></button>
    </div>
  </section>

  <!-- Details and the final project -->
  <section class="no-print px-3 pb-24 sm:px-6 lg:px-10 lg:pb-32">
    <div class:list={["mx-auto grid gap-4", cert.project ? "max-w-6xl lg:grid-cols-[minmax(0,1fr)_minmax(0,1.35fr)]" : "max-w-2xl"]}>
      <div class="bezel">
        <div class="bezel-core is-pearl h-full p-7 sm:p-9">
          <p class="text-caption font-medium text-cosmos-muted">Verificación</p>
          <p class="mt-2">
            Este certificado verifica que {cert.student} completó el curso <span class="font-medium">{course.name}</span> de Riverius AI Academy el {date}, impartido por Mariano Rivera.
          </p>
          <dl class="mt-6 divide-y divide-line border-y border-line text-[0.9375rem]">
            {[
              ["Emitido", date],
              ["Duración", `${course.hours} horas`],
              ["Instructor", "Mariano Rivera"],
            ].map(([k, v]) => (
              <div class="flex justify-between gap-4 py-3">
                <dt class="text-cosmos-muted">{k}</dt>
                <dd class="text-right font-medium">{v}</dd>
              </div>
            ))}
            <div class="py-3">
              <dt class="text-cosmos-muted">ID del certificado</dt>
              <dd class="mt-1 break-all font-mono text-caption">{cert.id}</dd>
            </div>
          </dl>
          <p class="mt-6 text-caption font-medium text-cosmos-muted">Habilidades</p>
          <ul class="mt-3 flex flex-wrap gap-2">
            {course.skills.map((s) => <li class="rounded-full bg-nacre px-3.5 py-1.5 text-caption font-medium">{s}</li>)}
          </ul>
        </div>
      </div>

      {cert.project && (
        <div class="bezel">
          <div class="bezel-core is-pearl flex h-full flex-col p-2.5">
            <VideoFacade id={cert.project.wistia} title={`Defensa del proyecto de ${cert.student}: ${cert.project.title}`} />
            <div class="p-5 sm:p-7">
              <p class="text-caption font-medium text-cosmos-muted">Proyecto final</p>
              <h2 class="mt-1 text-subheading font-semibold">{cert.project.title}</h2>
              <p class="mt-2 text-cosmos-muted">{cert.project.text}</p>
            </div>
          </div>
        </div>
      )}
    </div>

    <p class="mx-auto mt-14 max-w-6xl text-center text-cosmos-muted">
      ¿Quieres aprender a construir agentes de IA? <a href="/academy" class="font-medium text-cosmos underline underline-offset-4">Conoce Riverius AI Academy</a>.
    </p>
  </section>
</Academy>

<style>
  .cert-wrap {
    container-type: inline-size;
  }
  /* Fixed brand colors: the certificate looks the same in any theme and on paper. */
  .cert {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    aspect-ratio: 1.414;
    color: var(--color-ink);
    border: 0.55cqw solid transparent;
    border-radius: 2cqw;
    background:
      linear-gradient(#fffbf7, #fffbf7) padding-box,
      linear-gradient(135deg, var(--color-pitahaya), var(--color-mango) 50%, var(--color-jade)) border-box;
    box-shadow: 0 40px 80px -40px rgb(30 22 56 / 0.35);
    print-color-adjust: exact;
    -webkit-print-color-adjust: exact;
  }
  .cert-orb {
    position: absolute;
    z-index: -1;
    width: 34cqw;
    aspect-ratio: 1;
    border-radius: 9999px;
    filter: blur(6cqw);
    opacity: 0.45;
  }
  .orb-a { left: -14cqw; top: -16cqw; background: var(--color-pitahaya); }
  .orb-b { right: -14cqw; top: -12cqw; background: var(--color-mango); }
  .orb-c { right: 20cqw; bottom: -22cqw; background: var(--color-jade); }

  .cert-inner {
    position: absolute;
    inset: 2.4cqw;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 3.4cqw 6cqw 2.6cqw;
    border: 0.12cqw solid rgb(30 22 56 / 0.12);
    border-radius: 1.2cqw;
    text-align: center;
  }
  .cert-brand {
    display: inline-flex;
    align-items: center;
    gap: 0.8cqw;
    font-size: 2cqw;
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  .cert-brand svg { width: 2.1cqw; height: 2.1cqw; }
  .cert-brand span { font-weight: 300; opacity: 0.7; }
  .cert-title {
    margin-top: 3cqw;
    font-size: 5.6cqw;
    line-height: 1;
    font-weight: 300;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    margin-right: -0.32em;
  }
  .cert-subtitle {
    margin-top: 1cqw;
    font-size: 1.9cqw;
    font-weight: 500;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: #5e5873;
  }
  .cert-kicker {
    margin-top: 3.2cqw;
    font-size: 1.35cqw;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #5e5873;
  }
  .cert-name {
    margin-top: 1.4cqw;
    padding-bottom: 1.2cqw;
    font-size: 5.4cqw;
    line-height: 1.1;
    font-weight: 600;
    letter-spacing: -0.03em;
    background: linear-gradient(90deg, transparent, var(--color-pitahaya), var(--color-mango), var(--color-jade), transparent) bottom / 70% 0.35cqw no-repeat;
  }
  .cert-body {
    margin-top: 2cqw;
    max-width: 68cqw;
    font-size: 1.45cqw;
    line-height: 1.6;
    color: #3b3352;
  }
  .cert-body strong { font-weight: 600; color: var(--color-ink); }
  .cert-meta {
    margin-top: 1.6cqw;
    font-size: 1.4cqw;
    font-weight: 600;
  }
  .cert-footer {
    margin-top: auto;
    display: grid;
    width: 100%;
    grid-template-columns: 1fr auto 1fr;
    align-items: end;
    gap: 3cqw;
  }
  .cert-sign { text-align: left; }
  .cert-signature {
    display: inline-block;
    padding: 0 3cqw 0.6cqw 0;
    border-bottom: 0.12cqw solid rgb(30 22 56 / 0.35);
    font-size: 2.6cqw;
    font-weight: 300;
    font-style: italic;
    letter-spacing: -0.02em;
  }
  .cert-sign-name { margin-top: 0.8cqw; font-size: 1.3cqw; font-weight: 600; }
  .cert-sign-title { font-size: 1.2cqw; color: #5e5873; }
  .cert-seal {
    display: flex;
    width: 8.5cqw;
    aspect-ratio: 1;
    align-items: center;
    justify-content: center;
    border-radius: 9999px;
    color: var(--color-ink);
    background: linear-gradient(135deg, var(--color-pitahaya), var(--color-mango) 50%, var(--color-jade));
    box-shadow: inset 0 0 0 0.6cqw rgb(255 251 247 / 0.55), 0 1cqw 3cqw -1cqw rgb(255 158 210 / 0.8);
  }
  .cert-seal svg { width: 3.4cqw; height: 3.4cqw; }
  .cert-id { text-align: right; font-size: 1.05cqw; color: #5e5873; }
  .cert-id-value { margin: 0.3cqw 0; font-family: ui-monospace, monospace; font-size: 1.1cqw; color: var(--color-ink); }

  @media print {
    @page { size: A4 landscape; margin: 0; }
    :global(body *) { visibility: hidden; }
    .cert-wrap, .cert-wrap * { visibility: visible; }
    .cert-wrap { position: fixed; inset: 0; width: 100vw; }
    .cert { border-radius: 0; box-shadow: none; }
  }
</style>

<script>
  document.getElementById("print-cert")?.addEventListener("click", () => print());
  const copy = document.getElementById("copy-cert");
  copy?.addEventListener("click", async () => {
    const label = copy.querySelector("[data-copy-label]");
    try {
      await navigator.clipboard.writeText(copy.dataset.url ?? location.href);
      if (label) label.textContent = "¡Enlace copiado!";
    } catch {
      if (label) label.textContent = "No se pudo copiar";
    }
    setTimeout(() => label && (label.textContent = "Copiar enlace"), 2000);
  });
</script>
