---
// Repetitive-work calculator. Everything is calculated in the browser; nothing is sent anywhere.
import { Icon } from "astro-icon/components";
import Academy from "../../layouts/Academy.astro";
import Words from "../../components/Words.astro";
import { bookingLink, skoolLink } from "../../data/academy";
import { newTab } from "../../lib/links";

const booking = bookingLink(Astro.url.pathname);
const skool = skoolLink(Astro.url.pathname);
const currencies = ["USD", "CRC", "MXN", "COP", "EUR", "PEN", "GTQ"];
const examples = [
  { name: "Hacer cotizaciones", times: 5, minutes: 20 },
  { name: "Armar reportes", times: 1, minutes: 90 },
  { name: "Responder correos repetidos", times: 20, minutes: 5 },
  { name: "Agendar y confirmar citas", times: 10, minutes: 5 },
  { name: "Pasar datos a Excel", times: 5, minutes: 15 },
];

const field =
  "w-full rounded-[var(--radius-sm)] bg-pearl px-4 py-3 text-cosmos shadow-[inset_0_0_0_1px_var(--c-line)] transition-shadow duration-300 placeholder:text-cosmos-muted focus:shadow-[inset_0_0_0_2px_var(--c-action)] focus:outline-none";
const small = "text-caption font-medium text-cosmos-muted";
---

<Academy title="¿Cuánto te cuesta el trabajo repetitivo?" description="Calcula en 2 minutos cuántas horas y cuánto dinero pierdes al año en tareas repetitivas, y cuántas podrías recuperar.">
  <section class="relative isolate overflow-hidden px-4 pb-14 pt-36 text-center sm:px-6 lg:pb-20 lg:pt-44">
    <div class="glow sunrise left-1/2 top-[70%] -z-10 size-[680px] -translate-x-1/2 !opacity-45"></div>
    <p data-reveal class="pill-tag bg-pearl/70">
      <Icon name="ph:calculator-light" class="size-3.5" />
      Calculadora
    </p>
    <h1 class="display-xl mx-auto mt-7 max-w-[16ch]"><Words text="¿Cuánto te cuesta el trabajo repetitivo?" /></h1>
    <p data-reveal style="--i:6" class="mx-auto mt-7 max-w-[50ch] text-[1.0625rem] leading-[1.75rem] text-cosmos-muted">
      Anota las tareas que repites cada semana y descubre cuántas horas, y cuánto dinero, podrías recuperar.
    </p>
  </section>

  <section class="px-3 pb-24 sm:px-6 lg:px-10 lg:pb-32">
    <div id="calc" class="mx-auto grid max-w-7xl gap-6 lg:grid-cols-[1.25fr_1fr] lg:items-start">
      <!-- Inputs -->
      <div data-reveal class="bezel">
        <div class="bezel-core is-pearl p-6 sm:p-9">
          <div class="grid gap-6 sm:grid-cols-2">
            <div class="flex flex-col gap-2">
              <label for="rate" class="font-medium">Valor de tu hora</label>
              <div class="flex gap-2">
                <input id="rate" type="number" inputmode="decimal" min="0" step="any" placeholder="Ej. 15" class={field} />
                <label for="currency" class="sr-only">Moneda</label>
                <div class="relative shrink-0">
                  <select id="currency" class={`${field} w-28 cursor-pointer appearance-none pr-9`}>
                    {currencies.map((c) => <option value={c}>{c}</option>)}
                  </select>
                  <Icon name="ph:caret-down-light" class="pointer-events-none absolute right-3 top-1/2 size-4 -translate-y-1/2 text-cosmos-muted" />
                </div>
              </div>
            </div>
            <div class="flex flex-col gap-2">
              <label for="people" class="font-medium">Personas que hacen estas tareas</label>
              <input id="people" type="number" inputmode="numeric" min="1" step="1" value="1" class={field} aria-describedby="people-help" />
              <p id="people-help" class="text-caption text-cosmos-muted">Si calculas para tu equipo, pon cuántas personas las hacen.</p>
            </div>
          </div>

          <div class="mt-10 flex flex-wrap items-end justify-between gap-3">
            <h2 class="text-subheading font-semibold">Tus tareas repetitivas</h2>
            <button type="button" id="reset" class="inline-flex items-center gap-1.5 rounded-full px-3 py-1.5 text-caption font-medium text-cosmos-muted transition-colors hover:bg-nacre hover:text-cosmos">
              <Icon name="ph:arrow-counter-clockwise-light" class="size-4" />
              Reiniciar
            </button>
          </div>
          <p id="auto-help" class="mt-2 flex gap-2 text-caption text-cosmos-muted">
            <Icon name="ph:info-light" class="mt-0.5 size-4 shrink-0" />
            <span>¿Se puede automatizar? Si se repite, sigue siempre los mismos pasos y mueve información de un lugar a otro, probablemente sí.</span>
          </p>

          <ul id="tasks" class="mt-6 space-y-3" aria-label="Tareas"></ul>

          <button type="button" id="add" class="mt-4 inline-flex w-full items-center justify-center gap-2 rounded-[var(--radius-sm)] px-4 py-3 font-medium shadow-[inset_0_0_0_1px_var(--c-line)] transition-colors hover:bg-nacre">
            <Icon name="ph:plus-light" class="size-4" />
            Agregar tarea
          </button>

          <div class="mt-8">
            <p class={small}>Ejemplos rápidos</p>
            <div class="mt-3 flex flex-wrap gap-2">
              {examples.map((e) => (
                <button
                  type="button"
                  data-example={JSON.stringify(e)}
                  class="rounded-full bg-nacre px-3.5 py-2 text-caption font-medium shadow-[inset_0_0_0_1px_var(--c-line)] transition-colors hover:bg-line/60"
                >
                  + {e.name}
                </button>
              ))}
            </div>
          </div>
        </div>
      </div>

      <!-- Results -->
      <div class="space-y-4 lg:sticky lg:top-28">
        <dl class="grid gap-4 sm:grid-cols-2 lg:grid-cols-1">
          <div data-reveal class="bezel">
            <div class="bezel-core is-pearl p-6">
              <dt class={small}>Horas por semana en tareas repetitivas</dt>
              <dd id="out-week" class="mt-2 text-[2.5rem] font-semibold leading-none tracking-[-0.03em]">0</dd>
            </div>
          </div>
          <div data-reveal style="--i:1" class="bezel">
            <div class="bezel-core is-pearl p-6">
              <dt class={small}>Horas al año</dt>
              <dd id="out-year" class="mt-2 text-[2.5rem] font-semibold leading-none tracking-[-0.03em]">0</dd>
              <dd id="out-days" class="mt-2 text-caption text-cosmos-muted">Son 0 días de trabajo completos.</dd>
            </div>
          </div>
          <div data-reveal style="--i:2" class="bezel sm:col-span-2 lg:col-span-1">
            <div class="bezel-core is-pearl p-6">
              <dt class={small}>Costo al año</dt>
              <dd id="out-cost" class="mt-2 break-words text-[2.5rem] font-semibold leading-none tracking-[-0.03em]">—</dd>
              <dd id="out-cost-hint" class="mt-2 text-caption text-cosmos-muted">Agrega el valor de tu hora para ver cuánto dinero representa.</dd>
            </div>
          </div>
        </dl>

        <div data-reveal style="--i:3" class="sunrise-card relative isolate overflow-hidden rounded-[calc(var(--radius-lg)+8px)] p-7 sm:p-8">
          <p id="out-recover" aria-live="polite" class="text-subheading font-semibold">Podrías recuperar 0 horas por semana.</p>
        </div>
        <p class="px-1 text-caption text-cosmos-muted">Calculado con 48 semanas de trabajo al año.</p>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="px-3 pb-20 sm:px-6 lg:px-10 lg:pb-32">
    <div class="pearl-sheen relative isolate mx-auto max-w-7xl overflow-hidden rounded-[calc(var(--radius-lg)+8px)] bg-nacre px-6 py-20 text-center shadow-[inset_0_0_0_1px_var(--c-line)] sm:px-12 lg:py-28">
      <div class="glow sunrise left-1/2 top-full -z-10 size-[760px] -translate-x-1/2 -translate-y-1/2 !opacity-70"></div>
      <h2 class="display-lg mx-auto max-w-[18ch]"><Words text="Tu oficina automática puede devolverte esas horas." /></h2>
      <p data-reveal style="--i:3" class="mx-auto mt-6 max-w-[46ch] text-cosmos-muted">
        En una llamada de 20 minutos vemos cuáles de estas tareas automatizar primero y cómo. Sin compromiso.
      </p>
      <div data-reveal style="--i:4" class="mt-10 flex flex-wrap justify-center gap-3">
        <a id="cta-primary" href={booking} {...newTab(booking)} data-solo={booking} data-team="/academy/equipos" class="btn btn-primary group" data-magnetic>
          <span data-cta-label>Agenda una llamada</span>
          <span class="btn-island" aria-hidden="true"><Icon name="ph:arrow-up-right" class="size-4" /></span>
        </a>
        <a href={skool} {...newTab(skool)} class="btn btn-ghost btn-plain">Empieza gratis en Skool</a>
      </div>
    </div>
  </section>

  <!-- One task row; cloned by the script. -->
  <template id="task-row">
    <li class="task rounded-[var(--radius-md)] bg-nacre p-4 shadow-[inset_0_0_0_1px_var(--c-line)]">
      <div class="grid grid-cols-[1fr_auto] items-end gap-3 sm:grid-cols-[1fr_6.5rem_6.5rem_auto]">
        <div class="flex flex-col gap-1.5">
          <label data-for="name" class={small}>Tarea</label>
          <input data-field="name" type="text" placeholder="Ej. Hacer cotizaciones" class={field} />
        </div>
        <div class="col-span-2 grid grid-cols-2 gap-3 sm:col-span-1 sm:contents">
          <div class="flex flex-col gap-1.5">
            <label data-for="times" class={small}>Veces por semana</label>
            <input data-field="times" type="number" inputmode="decimal" min="0" step="any" class={field} />
          </div>
          <div class="flex flex-col gap-1.5">
            <label data-for="minutes" class={small}>Minutos por vez</label>
            <input data-field="minutes" type="number" inputmode="decimal" min="0" step="any" class={field} />
          </div>
        </div>
        <button type="button" data-remove class="col-start-2 row-start-1 inline-flex size-12 items-center justify-center rounded-full text-cosmos-muted transition-colors hover:bg-line/60 hover:text-cosmos sm:col-start-auto sm:row-start-auto">
          <Icon name="ph:trash-light" class="size-5" />
        </button>
      </div>
      <label class="mt-3 inline-flex cursor-pointer items-center gap-2.5 text-[0.9375rem]">
        <input data-field="auto" type="checkbox" checked aria-describedby="auto-help" class="size-4 cursor-pointer accent-cosmos" />
        ¿Se puede automatizar?
      </label>
    </li>
  </template>
</Academy>

<script>
  type Task = { name: string; times: string; minutes: string; auto: boolean };
  type State = { rate: string; currency: string; people: string; tasks: Task[] };

  const KEY = "riverius-calculadora";
  const WEEKS = 48;
  const empty = (): Task => ({ name: "", times: "", minutes: "", auto: true });
  const fresh = (): State => ({ rate: "", currency: "USD", people: "1", tasks: [empty()] });

  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const rate = $<HTMLInputElement>("rate");
  const currency = $<HTMLSelectElement>("currency");
  const people = $<HTMLInputElement>("people");
  const list = $<HTMLUListElement>("tasks");
  const template = $<HTMLTemplateElement>("task-row");
  const cta = $<HTMLAnchorElement>("cta-primary");

  const hours = new Intl.NumberFormat("es-419", { maximumFractionDigits: 1, useGrouping: "always" } as Intl.NumberFormatOptions);
  const money = new Intl.NumberFormat("es-419", { maximumFractionDigits: 0, useGrouping: "always" } as Intl.NumberFormatOptions);
  const num = (v: string) => Math.max(0, Number(v.replace(",", ".")) || 0);

  const load = (): State => {
    try {
      const saved = JSON.parse(localStorage.getItem(KEY) ?? "null") as State | null;
      if (saved && Array.isArray(saved.tasks)) return { ...fresh(), ...saved, tasks: saved.tasks.length ? saved.tasks : [empty()] };
    } catch {}
    return fresh();
  };
  const save = (state: State) => {
    try {
      localStorage.setItem(KEY, JSON.stringify(state));
    } catch {}
  };

  let rowId = 0;
  const addRow = (task: Task, focus = false) => {
    const row = (template.content.firstElementChild as HTMLLIElement).cloneNode(true) as HTMLLIElement;
    const id = `task-${++rowId}`;
    row.querySelectorAll<HTMLInputElement>("[data-field]").forEach((input) => {
      const key = input.dataset.field as keyof Task;
      input.id = `${id}-${key}`;
      if (key === "auto") input.checked = task.auto;
      else input.value = String(task[key]);
    });
    row.querySelectorAll<HTMLLabelElement>("[data-for]").forEach((label) => (label.htmlFor = `${id}-${label.dataset.for}`));
    list.append(row);
    if (focus) row.querySelector<HTMLInputElement>('[data-field="name"]')?.focus();
  };

  const read = (): State => ({
    rate: rate.value,
    currency: currency.value,
    people: people.value,
    tasks: [...list.querySelectorAll<HTMLLIElement>(".task")].map((row) => {
      const get = (k: string) => row.querySelector<HTMLInputElement>(`[data-field="${k}"]`)!;
      return { name: get("name").value, times: get("times").value, minutes: get("minutes").value, auto: get("auto").checked };
    }),
  });

  const render = () => {
    const state = read();
    save(state);

    // Name each delete button after its task, so screen readers know which one it removes.
    list.querySelectorAll<HTMLLIElement>(".task").forEach((row, i) => {
      const name = state.tasks[i].name.trim();
      row.querySelector("[data-remove]")!.setAttribute("aria-label", `Eliminar tarea${name ? `: ${name}` : ` ${i + 1}`}`);
    });

    const crew = Math.max(1, Math.round(num(state.people)) || 1);
    const perTask = state.tasks.map((t) => ({ hours: (num(t.times) * num(t.minutes)) / 60, auto: t.auto }));
    const week = perTask.reduce((sum, t) => sum + t.hours, 0) * crew;
    const year = week * WEEKS;
    const recoverWeek = perTask.filter((t) => t.auto).reduce((sum, t) => sum + t.hours, 0) * crew;
    const recoverYear = recoverWeek * WEEKS;
    const hourly = num(state.rate);
    const cash = (amount: number) => `${state.currency} ${money.format(amount)}`;

    $("out-week").textContent = hours.format(week);
    $("out-year").textContent = hours.format(year);
    $("out-days").textContent = `Son ${hours.format(year / 8)} días de trabajo completos.`;
    $("out-cost").textContent = hourly ? cash(year * hourly) : "—";
    $("out-cost-hint").classList.toggle("hidden", !!hourly);
    $("out-recover").textContent = hourly
      ? `Podrías recuperar ${hours.format(recoverWeek)} horas por semana. Al año son ${hours.format(recoverYear)} horas y ${cash(recoverYear * hourly)} que hoy se van en trabajo repetitivo.`
      : `Podrías recuperar ${hours.format(recoverWeek)} horas por semana. Al año son ${hours.format(recoverYear)} horas que hoy se van en trabajo repetitivo.`;

    // Teams get sent to the team training page instead of a personal call.
    const team = crew > 1;
    cta.href = team ? cta.dataset.team! : cta.dataset.solo!;
    // The booking link opens in a new tab; the team page is part of this site.
    if (team) cta.removeAttribute("target");
    else cta.target = "_blank";
    cta.querySelector("[data-cta-label]")!.textContent = team ? "Capacita a tu equipo" : "Agenda una llamada";
  };

  const apply = (state: State) => {
    rate.value = state.rate;
    currency.value = state.currency;
    people.value = state.people;
    list.replaceChildren();
    state.tasks.forEach((t) => addRow(t));
    render();
  };

  document.getElementById("calc")!.addEventListener("input", render);
  list.addEventListener("click", (e) => {
    const remove = (e.target as HTMLElement).closest("[data-remove]");
    if (!remove) return;
    const row = remove.closest("li")!;
    const next = (row.nextElementSibling ?? row.previousElementSibling) as HTMLElement | null;
    row.remove();
    if (!list.children.length) addRow(empty());
    (next ?? list.firstElementChild)?.querySelector<HTMLInputElement>('[data-field="name"]')?.focus();
    render();
  });
  $("add").addEventListener("click", () => {
    addRow(empty(), true);
    render();
  });
  document.querySelectorAll<HTMLButtonElement>("[data-example]").forEach((btn) =>
    btn.addEventListener("click", () => {
      const e = JSON.parse(btn.dataset.example!) as { name: string; times: number; minutes: number };
      const task = { name: e.name, times: String(e.times), minutes: String(e.minutes), auto: true };
      // Fill the first row if it's still blank; otherwise add a new one.
      const rows = [...list.querySelectorAll<HTMLLIElement>(".task")];
      const blank = rows.length === 1 && read().tasks.every((t) => !t.name && !t.times && !t.minutes);
      if (blank) rows[0].remove();
      addRow(task);
      render();
    }),
  );
  $("reset").addEventListener("click", () => {
    try {
      localStorage.removeItem(KEY);
    } catch {}
    apply(fresh());
    rate.focus();
  });

  apply(load());
</script>
