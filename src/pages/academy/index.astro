---
// Academy hub. Its one job: send each visitor to the right path (Mentoría, Aceleradora IA or Equipos).
import Academy from "../../layouts/Academy.astro";
import AcademyHero from "../../components/academy/AcademyHero.astro";
import Stats from "../../components/academy/Stats.astro";
import Paths from "../../components/academy/Paths.astro";
import ClosingCta from "../../components/academy/ClosingCta.astro";
import { skoolLink } from "../../data/academy";

const skool = skoolLink(Astro.url.pathname);
---

<Academy>
  <AcademyHero
    tag="Riverius AI Academy"
    title="Que la IA haga el trabajo repetitivo. Tú, el que importa."
    text="Construye tu propio agente de IA, aprende a venderlo a otros negocios o capacita a tu equipo. Sin programar."
    primary={{ label: "Elige tu camino", href: "#caminos" }}
    secondary={{ label: "Únete gratis a Skool", href: skool }}
  />
  <Stats />
  <Paths />
  <ClosingCta
    title="¿Aún no sabes por dónde empezar?"
    text="Únete gratis a la comunidad en Skool y crea tu primer agente de IA en 15 minutos."
    cta={{ label: "Únete gratis", href: skool }}
    secondary={{ label: "Elige tu camino", href: "#caminos" }}
  />
</Academy>
