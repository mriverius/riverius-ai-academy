---
import { Icon } from "astro-icon/components";
import Academy from "../../layouts/Academy.astro";
import AcademyHero from "../../components/academy/AcademyHero.astro";
import FreeStart from "../../components/academy/FreeStart.astro";
import StepPath from "../../components/academy/StepPath.astro";
import HowItWorks from "../../components/academy/HowItWorks.astro";
import Stories from "../../components/academy/Stories.astro";
import Mentors from "../../components/academy/Mentors.astro";
import Faq from "../../components/academy/Faq.astro";
import ClosingCta from "../../components/academy/ClosingCta.astro";
import CalcCta from "../../components/academy/CalcCta.astro";
import Offer from "../../components/academy/Offer.astro";
import Words from "../../components/Words.astro";
import Button from "../../components/Button.astro";
import { academy, proClasses, proOffer, officePieces, faqPro, bookingLink, skoolLink } from "../../data/academy";
import { course, faqPage } from "../../lib/schema";

const booking = bookingLink(Astro.url.pathname);
const skool = skoolLink(Astro.url.pathname);
const steps = proClasses.map((c, i) => ({ kicker: `Clase ${i + 1}`, title: c.title, text: c.text }));
---

<Academy
  title="Construye tu oficina automática"
  description="Construye tu oficina automática en 6 clases: cotizaciones, reportes y citas que se hacen solos, sin programar. Empieza gratis en Skool."
  schema={[
    course({ name: proOffer.title, description: `${proOffer.promise} ${proClasses.map((c, i) => `Clase ${i + 1}: ${c.title}. ${c.text}`).join(" ")}`, path: "/academy/automatizar" }),
    faqPage(faqPro),
  ]}
>
  <AcademyHero
    compact
    tag="Automatiza tu trabajo"
    title="Construye tu oficina automática."
    text="Cotizaciones, reportes, correos y citas que se hacen solos, construidos con tus procesos reales. Sin programar."
    primary={{ label: "Ver el programa", href: "#programa" }}
    secondary={{ label: "Agenda una llamada", href: booking }}
  />
  <FreeStart />

  <!-- Program -->
  <section id="programa" class="scroll-mt-24 px-3 py-24 sm:px-6 lg:px-10 lg:py-36">
    <div class="mx-auto grid max-w-7xl gap-12 lg:grid-cols-[1fr_1.4fr] lg:gap-20">
      <div class="px-1 lg:sticky lg:top-32 lg:self-start">
        <p data-reveal class="pill-tag">El programa</p>
        <h2 class="display-lg mt-6"><Words text="6 clases. Tu oficina, trabajando sola." /></h2>
        <p data-reveal class="mt-6 max-w-[42ch] text-cosmos-muted">
          Cada clase termina con una pieza nueva funcionando, construida sobre tu propio trabajo.
        </p>
        <div data-reveal class="mt-8"><Button href="#inscripcion">Ver lo que incluye</Button></div>
      </div>
      <StepPath id="pro" steps={steps} finish={{ kicker: "Al terminar", title: "Tu certificado de Riverius AI Academy" }} />
    </div>
  </section>

  <HowItWorks />
  <div class="h-24 lg:h-36"></div>
  <!-- The five pieces of an automated office -->
  <section class="px-3 pb-24 sm:px-6 lg:px-10 lg:pb-36">
    <div class="mx-auto max-w-7xl">
      <div class="px-1">
        <p data-reveal class="pill-tag">Tu oficina automática</p>
        <h2 class="display-lg mt-6 max-w-[18ch]"><Words text="Las 5 piezas de tu oficina automática." /></h2>
      </div>
      <ol class="mt-14 grid gap-4 md:grid-cols-2 lg:grid-cols-6">
        {officePieces.map((piece, i) => (
          <li data-reveal style={`--i:${i}`} class:list={["bezel", i < 3 ? "lg:col-span-2" : "lg:col-span-3"]}>
            <div class="bezel-core is-pearl spotlight flex h-full flex-col p-7 sm:p-9">
              <div class="flex items-center justify-between">
                <span class="inline-flex size-12 items-center justify-center rounded-full bg-nacre shadow-[inset_0_0_0_1px_var(--c-line)]">
                  <Icon name={piece.icon} class="size-6" />
                </span>
                <span class="text-caption font-medium text-cosmos-muted">0{i + 1}</span>
              </div>
              <h3 class="mt-10 text-subheading font-semibold">{piece.title}</h3>
              <p class="mt-2 text-cosmos-muted">{piece.text}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>
  <CalcCta text="¿Cuántas horas te devolvería tu oficina?" label="Calcúlalo" class="pb-24 lg:pb-36" />
  <Stories title="Profesionales que ya recuperaron sus horas." only={["Andrey Espinoza", "Fabián Morales", "Bernal Barrantes", "Esteban Hidalgo"]} />

  <!-- Enrollment -->
  <section id="inscripcion" class="scroll-mt-24 px-3 py-24 sm:px-6 lg:px-10 lg:py-36">
    <div class="mx-auto grid max-w-6xl items-center gap-12 lg:grid-cols-[1fr_1.1fr] lg:gap-20">
      <div class="px-1">
        <p data-reveal class="pill-tag">Inscripción</p>
        <h2 class="display-lg mt-6"><Words text="Todo lo que necesitas para automatizar tu trabajo." /></h2>
        <p data-reveal class="mt-6 max-w-[44ch] text-cosmos-muted">¿Tienes dudas antes de empezar? Agenda una llamada o escríbenos por WhatsApp.</p>
        <div data-reveal class="mt-8 flex flex-wrap gap-3">
          <Button href={booking}>Agenda una llamada</Button>
          <Button href={academy.whatsapp} variant="ghost" icon="ph:whatsapp-logo-light">WhatsApp</Button>
        </div>
      </div>
      <Offer {...proOffer} href={booking} />
    </div>
  </section>

  <Mentors />
  <Faq items={faqPro} />
  <ClosingCta
    title="Empieza hoy. Gratis, en 30 minutos."
    text="Únete a la comunidad en Skool y automatiza la primera parte de tu oficina antes de decidir nada más."
    cta={{ label: "Únete gratis", href: skool }}
  />
</Academy>
