---
import { Icon } from "astro-icon/components";
import Academy from "../../layouts/Academy.astro";
import AcademyHero from "../../components/academy/AcademyHero.astro";
import TrustStrip from "../../components/academy/TrustStrip.astro";
import StepPath from "../../components/academy/StepPath.astro";
import HowItWorks from "../../components/academy/HowItWorks.astro";
import Pricing from "../../components/academy/Pricing.astro";
import Stories from "../../components/academy/Stories.astro";
import Mentors from "../../components/academy/Mentors.astro";
import Guarantee from "../../components/academy/Guarantee.astro";
import Faq from "../../components/academy/Faq.astro";
import ClosingCta from "../../components/academy/ClosingCta.astro";
import CalcCta from "../../components/academy/CalcCta.astro";
import Words from "../../components/Words.astro";
import Button from "../../components/Button.astro";
import { academy, proClasses, agentSteps, automatizarStories, faqPro, mentoriaPromise, skoolLink } from "../../data/academy";
import { course, faqPage } from "../../lib/schema";

const page = Astro.url.pathname;
const steps = proClasses.map((c, i) => ({ kicker: `Clase ${i + 1}`, title: c.title, text: c.text }));
---

<Academy
  title="Construye tu oficina automática"
  description="Construye tu oficina automática sin programar. Empieza gratis, aprende a tu ritmo con Premium o crea tu agente de ventas por WhatsApp en 6 semanas con la Mentoría."
  schema={[
    course({ name: "Construye tu oficina automática", description: `${mentoriaPromise} ${proClasses.map((c, i) => `Clase ${i + 1}: ${c.title}. ${c.text}`).join(" ")}`, path: "/academy/automatizar" }),
    faqPage(faqPro),
  ]}
>
  <AcademyHero
    compact
    tag="Automatiza tu trabajo"
    title="Construye tu oficina automática."
    text="Cotizaciones, reportes, correos y citas que se hacen solos, construidos con tus procesos reales. Sin programar."
    primary={{ label: "Empieza gratis", href: skoolLink(page, "hero") }}
    secondary={{ label: "Ver opciones y precios", href: "#opciones" }}
    footnote="Tu primera automatización en 30 minutos, gratis."
  />
  <TrustStrip />

  <!-- What you learn: the 6 classes -->
  <section id="programa" class="scroll-mt-24 px-3 py-24 sm:px-6 lg:px-10 lg:py-36">
    <div class="mx-auto grid max-w-7xl gap-12 lg:grid-cols-[1fr_1.4fr] lg:gap-20">
      <div class="px-1 lg:sticky lg:top-32 lg:self-start">
        <p data-reveal class="pill-tag">El programa</p>
        <h2 class="display-lg mt-6"><Words text="Lo que aprendes: 6 clases, de cero a tu propio asistente de IA." /></h2>
        <p data-reveal class="mt-6 max-w-[42ch] text-cosmos-muted">
          En Premium ves las clases en video, a tu ritmo. En la Mentoría no sigues el temario en orden: construimos tu agente desde la primera semana y usamos las clases solo como apoyo. Cada clase termina con algo funcionando.
        </p>
        <div data-reveal class="mt-8"><Button href="#opciones">Ver lo que incluye</Button></div>
      </div>
      <StepPath
        id="pro"
        steps={steps}
        finish={{
          kicker: "Al terminar",
          title: "Tu certificado de Riverius AI Academy",
          text: "Agrégalo a tu perfil de LinkedIn y a tu currículum, con Riverius AI como la organización que lo emite. Así, empleadores y clientes ven que sabes automatizar tu trabajo con IA.",
          link: { label: "Síguenos en LinkedIn", href: academy.linkedinCompany, icon: "ph:linkedin-logo-light" },
        }}
      />
    </div>
  </section>

  <!-- What the Mentoría leaves you with: your WhatsApp sales agent -->
  <section class="px-3 pb-24 sm:px-6 lg:px-10 lg:pb-36">
    <div class="mx-auto max-w-7xl">
      <div class="px-1">
        <p data-reveal class="pill-tag">Mentoría</p>
        <h2 class="display-lg mt-6 max-w-[20ch]"><Words text="Tu negocio responde y vende por WhatsApp, las 24 horas." /></h2>
        <p data-reveal class="mt-6 max-w-[46ch] text-cosmos-muted">Un agente de IA que conoce tus productos, responde a tus clientes, toma sus datos y te avisa cuando hay una venta. Lo construimos juntos en 6 semanas, con tu información real.</p>
      </div>
      <ol class="mt-14 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
        {agentSteps.map((piece, i) => (
          <li data-reveal style={`--i:${i}`} class="bezel">
            <div class="bezel-core is-pearl spotlight flex h-full flex-col p-7 sm:p-9">
              <div class="flex items-center justify-between">
                <span class="inline-flex size-12 items-center justify-center rounded-full bg-nacre shadow-[inset_0_0_0_1px_var(--c-line)]">
                  <Icon name={piece.icon} class="size-6" />
                </span>
                <span class="text-caption font-medium text-cosmos-muted">0{i + 1}</span>
              </div>
              <h3 class="mt-10 text-subheading font-semibold">{piece.title}</h3>
              <p class="mt-2 text-cosmos-muted">{piece.text}</p>
            </div>
          </li>
        ))}
        <!-- Same finish card as the program's "Al terminar". -->
        <li data-reveal style={`--i:${agentSteps.length}`} class="md:col-span-2 lg:col-span-3">
          <div class="sunrise-card relative isolate flex flex-col gap-5 overflow-hidden rounded-[calc(var(--radius-lg)+8px)] p-7 sm:flex-row sm:items-center sm:gap-8 sm:p-10">
            <span class="inline-flex size-12 shrink-0 items-center justify-center rounded-full bg-cosmos text-pearl">
              <Icon name="ph:seal-check-light" class="size-6" />
            </span>
            <div>
              <p class="text-caption font-medium">Al terminar</p>
              <h3 class="mt-2 text-heading">Tu certificado de Riverius AI Academy</h3>
              <p class="mt-3 max-w-[64ch]">Al completar tu mentoría recibes tu certificado para agregarlo a tu perfil de LinkedIn y a tu currículum, con Riverius AI como la organización que lo emite. Así, empleadores y clientes ven que sabes construir agentes de IA.</p>
            </div>
          </div>
        </li>
      </ol>
      <div data-reveal class="mt-10 flex flex-col items-start gap-5 px-1 sm:flex-row sm:items-center sm:justify-between">
        <p class="max-w-[58ch] text-[0.9375rem] text-cosmos-muted">
          ¿Tu agente es de soporte interno, recordatorios u otro uso? La ruta se adapta a tu caso y lo definimos antes de empezar.
        </p>
        <Button href="#opciones" class="shrink-0">Quiero mi agente</Button>
      </div>
    </div>
  </section>

  <HowItWorks />
  <CalcCta text="¿Cuántas horas te devolvería tu oficina?" label="Calcúlalo" class="pt-24 lg:pt-36" />
  <Pricing />
  <Stories title="Negocios que ya atienden y venden con su agente." items={automatizarStories} />
  <Mentors />
  <Guarantee />
  <Faq items={faqPro} />
  <ClosingCta
    title="Empieza hoy. Gratis, en 30 minutos."
    text="Únete a la comunidad en Skool y automatiza la primera parte de tu oficina antes de decidir nada más."
    cta={{ label: "Únete gratis", href: skoolLink(page, "cierre") }}
    link={{ label: "o mira las opciones de Premium y Mentoría", href: "#opciones" }}
  />
</Academy>
