---
import { getCollection } from "astro:content";
import { Icon } from "astro-icon/components";
import Base from "../../layouts/Base.astro";
import PageHero from "../../components/PageHero.astro";
import CaseCover from "../../components/CaseCover.astro";
import CtaPanel from "../../components/CtaPanel.astro";

const cases = (await getCollection("work")).sort((a, b) => a.data.order - b.data.order);
---

<Base title="Work" description="How teams around the world get hours back with practical AI.">
  <PageHero tag="Case studies" title="Work from teams like *yours.*" text="Cooperatives, schools and public institutions that now spend less time on repetitive work." />

  <section class="px-3 py-20 sm:px-6 lg:px-10 lg:py-28">
    <div class="mx-auto grid max-w-7xl gap-4 md:grid-cols-2">
      {
        cases.map((c, i) => (
          <a href={`/work/${c.id}`} data-reveal style={`--i:${i % 2}`} class:list={["group bezel", i === 0 && "md:col-span-2"]}>
            <div class:list={["bezel-core is-pearl flex h-full flex-col p-3", i === 0 && "md:grid md:grid-cols-[1.2fr_1fr] md:gap-3"]}>
              <CaseCover tone={c.data.tone} cover={c.data.cover} class="aspect-[16/10]" />
              <div class="flex flex-1 flex-col p-5 sm:p-8">
                <p class="text-caption text-cosmos-muted">{c.data.client}, {c.data.industry}, {c.data.country}</p>
                <h2 class="mt-2 text-heading">{c.data.title}</h2>
                <p class="mt-3 text-cosmos-muted">{c.data.summary}</p>
                <span class="mt-auto inline-flex items-center gap-2 pt-8 font-medium">
                  Read the case
                  <Icon name="ph:arrow-right-light" class="size-5 transition-transform duration-500 ease-[var(--ease-drawer)] group-hover:translate-x-1" />
                </span>
              </div>
            </div>
          </a>
        ))
      }
    </div>
  </section>

  <CtaPanel />
</Base>
