---
import { Icon } from "astro-icon/components";
import { Image, getImage } from "astro:assets";
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import CtaPanel from "../components/CtaPanel.astro";
import Words from "../components/Words.astro";
import { team, featured, principles } from "../data/team";
import { person as personSchema } from "../lib/schema";

const schema = await Promise.all(team.map(async (p) => personSchema(p, (await getImage({ src: p.photo, width: 880 })).src)));
---

<Base title="Team" description="Meet the people behind Riverius AI." schema={schema}>
  <PageHero tag="Team" title="The people behind *Riverius.*" text="Engineers and educators who build AI systems every day, and stay until your team uses them." />

  <section class="space-y-24 px-3 pb-10 pt-16 sm:px-6 lg:space-y-36 lg:px-10 lg:pt-24">
    {
      team.map((person, i) => (
        <div class="mx-auto grid max-w-6xl items-center gap-12 lg:grid-cols-2 lg:gap-20">
          <div data-reveal class:list={["relative mx-auto w-full max-w-[440px]", i % 2 === 1 && "lg:order-2"]}>
            <div class="glow aurora left-[8%] top-[8%] size-[84%] !opacity-40" />
            <div class="portrait relative aspect-square overflow-hidden rounded-full">
              <Image
                src={person.photo}
                alt={`${person.name}, ${person.role}`}
                widths={[440, 880]}
                sizes="(min-width: 480px) 440px, calc(100vw - 40px)"
                loading={i === 0 ? "eager" : "lazy"}
                class="size-full object-cover"
              />
            </div>
          </div>

          <div class="px-1">
            <p data-reveal class="pill-tag">Co-founder</p>
            <h2 class="display-lg mt-6"><Words text={person.name} /></h2>
            <p data-reveal class="mt-3 text-subheading font-semibold text-cosmos-muted">{person.role}</p>
            <div data-reveal class="mt-6 space-y-4 text-[1.0625rem] leading-[1.75rem] text-cosmos-muted">
              {person.bio.map((p) => <p>{p}</p>)}
            </div>
            {person.credentials.length > 0 && (
              <ul data-reveal class="mt-8 flex flex-wrap gap-2">
                {person.credentials.map((c) => (
                  <li class="rounded-full bg-nacre px-3.5 py-1.5 text-caption font-medium">{c}</li>
                ))}
              </ul>
            )}
            {person.links.length > 0 && (
              <ul data-reveal class="mt-8 flex gap-2">
                {person.links.map((l) => (
                  <li>
                    <a href={l.href} aria-label={`${person.name} on ${l.label}`} class="inline-flex size-11 items-center justify-center rounded-full shadow-[inset_0_0_0_1px_var(--c-line)] transition-colors duration-300 hover:bg-nacre">
                      <Icon name={l.icon} class="size-5" />
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </div>
        </div>
      ))
    }
  </section>

  <!-- Recognition -->
  <section class="px-4 py-16 sm:px-6 lg:px-10 lg:py-24">
    <div class="mx-auto max-w-6xl">
      <p data-reveal class="text-center text-caption text-cosmos-muted">Featured and recognized by</p>
      <ul class="mt-10 grid grid-cols-1 gap-4 sm:grid-cols-3">
        {featured.map((f, i) => (
          <li data-reveal style={`--i:${i}`} class="bezel">
            <div class="bezel-core flex h-full flex-col items-center justify-center gap-4 px-6 py-10 text-center">
              <Image src={f.logo} alt={f.name} height={96} class="logo-mono h-12 w-auto max-w-[160px] object-contain" />
              <p class="text-caption text-cosmos-muted">{f.note}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Principles -->
  <section class="px-3 pb-8 pt-16 sm:px-6 lg:px-10 lg:pt-24">
    <div class="mx-auto max-w-6xl">
      <h2 class="display-lg max-w-[16ch] px-1"><Words text="How we work, as a team." /></h2>
      <div class="mt-14 grid gap-4 md:grid-cols-2">
        {principles.map((p, i) => (
          <div data-reveal style={`--i:${i}`} class="bezel">
            <div class:list={["bezel-core spotlight flex h-full gap-6 p-7 sm:p-9", i === 0 && "pearl-sheen"]}>
              <span class="inline-flex size-12 shrink-0 items-center justify-center rounded-full bg-pearl shadow-[inset_0_0_0_1px_var(--c-line)]">
                <Icon name={p.icon} class="size-6" />
              </span>
              <div>
                <h3 class="text-subheading font-semibold">{p.title}</h3>
                <p class="mt-2 text-cosmos-muted">{p.text}</p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <CtaPanel title="Work with people who *build.*" />
</Base>

<style>
  .portrait {
    box-shadow:
      0 0 0 1px rgb(255 251 247 / 0.12),
      0 40px 80px -30px rgb(195 168 255 / 0.5);
  }
  /* Recognition logos in one light tone on Cosmos. */
  .logo-mono {
    filter: grayscale(1) brightness(0) invert(1);
    opacity: 0.75;
  }
</style>
