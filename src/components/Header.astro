---
import Logo from "./Logo.astro";
import { newTab } from "../lib/links";

type Link = { label: string; href: string; highlight?: boolean };
interface Props {
  nav: Link[];
  cta: Link;
  suffix: string;
  home: string;
  menuExtra?: Link[];
  /** Small cross-link to the sister brand, shown in the pill on desktop. */
  sister?: Link;
  /** Logo mark: the agency star (default) or the Academy R. */
  mark?: "star" | "r";
}
const { nav, cta, suffix, home, menuExtra = [], sister, mark } = Astro.props;
const path = Astro.url.pathname;
const menuLabel = { open: suffix.includes("Academy") ? "Abrir menú" : "Open menu", close: suffix.includes("Academy") ? "Cerrar menú" : "Close menu" };
---

<header
  id="site-header"
    class="fixed inset-x-0 top-0 z-40 flex justify-center px-3 pt-4 sm:pt-5"
>
  <div
    class="nav-pill flex h-14 w-full max-w-[68rem] items-center justify-between gap-6 rounded-full bg-[var(--nav-bg)] pl-5 pr-2 text-cosmos shadow-[inset_0_0_0_1px_var(--bezel-ring),inset_0_1px_0_var(--bezel-highlight),0_20px_50px_-30px_rgb(30_22_56/0.5)] backdrop-blur-md backdrop-saturate-150"
  >
    <Logo mark={mark} suffix={suffix} href={home} />

    <nav class="hidden items-center gap-0.5 lg:flex" aria-label="Primary">
      {
        nav.map((item) => item.highlight ? (
          <a href={item.href} class="academy-chip group ml-1 inline-flex items-center gap-1.5 rounded-full px-3.5 py-1.5 text-[0.8125rem] font-medium">
            <svg viewBox="0 0 24 24" class="size-3 transition-transform duration-700 ease-[var(--ease-drawer)] group-hover:rotate-90" aria-hidden="true"><path fill="currentColor" d="M12 0C12.8 7 17 11.2 24 12C17 12.8 12.8 17 12 24C11.2 17 7 12.8 0 12C7 11.2 11.2 7 12 0Z" /></svg>
            {item.label}
          </a>
        ) : (
          <a
            href={item.href}
            aria-current={path.startsWith(item.href) && !item.href.includes("#") ? "page" : undefined}
            class="whitespace-nowrap rounded-full px-3.5 py-2 text-[0.875rem] text-cosmos-muted transition-colors duration-300 hover:text-cosmos aria-[current=page]:text-cosmos"
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-1">
      {sister && (
        <a href={sister.href} class="sister-chip group mr-1 hidden shrink-0 items-center whitespace-nowrap gap-1.5 rounded-full py-2 pl-3 pr-3.5 text-[0.8125rem] font-medium lg:inline-flex">
          <svg viewBox="0 0 24 24" class="size-3 text-guaria transition-transform duration-700 ease-[var(--ease-drawer)] group-hover:rotate-90" aria-hidden="true"><path fill="currentColor" d="M12 0C12.8 7 17 11.2 24 12C17 12.8 12.8 17 12 24C11.2 17 7 12.8 0 12C7 11.2 11.2 7 12 0Z" /></svg>
          {sister.label}
          <svg viewBox="0 0 16 16" class="size-3 opacity-70 transition-transform duration-500 group-hover:-translate-y-px group-hover:translate-x-px" aria-hidden="true"><path d="M5 11 11 5M6 5h5v5" fill="none" stroke="currentColor" stroke-width="1.3" /></svg>
        </a>
      )}
      <a href={cta.href} {...newTab(cta.href)} class="btn btn-primary btn-plain hidden shrink-0 !py-2.5 !text-[0.875rem] sm:inline-flex">{cta.label}</a>
      <button
        id="menu-toggle"
        type="button"
        class="relative inline-flex size-10 items-center justify-center rounded-full lg:hidden"
        aria-expanded="false"
        aria-controls="menu-overlay"
        aria-label={menuLabel.open}
        data-open-label={menuLabel.open}
        data-close-label={menuLabel.close}
      >
        <span class="bar absolute h-[1.5px] w-5 -translate-y-[4px] rounded-full bg-current transition-transform duration-500 ease-[var(--ease-drawer)]"></span>
        <span class="bar absolute h-[1.5px] w-5 translate-y-[4px] rounded-full bg-current transition-transform duration-500 ease-[var(--ease-drawer)]"></span>
      </button>
    </div>
  </div>
</header>

<div
  id="menu-overlay"
  class="invisible fixed inset-0 z-30 flex flex-col justify-end bg-pearl/95 px-6 pb-12 pt-28 opacity-0 backdrop-blur-md transition-[opacity,visibility] duration-500 ease-[var(--ease-out-soft)] lg:hidden"
>
  <nav class="flex flex-col" aria-label="Mobile">
    {
      [...nav, ...menuExtra, ...(sister ? [sister] : [])].map((item, i) => (
        <a href={item.href} class="menu-link block overflow-hidden py-2 text-[2.5rem] font-semibold leading-tight tracking-[-0.03em]" style={`--i:${i}`}>
          <span class:list={["block", "highlight" in item && item.highlight && "sunrise-text"]}>{item.label}</span>
        </a>
      ))
    }
  </nav>
</div>

<style>
  @media (prefers-reduced-motion: no-preference) {
    .nav-pill {
      animation: pill-in 1.2s var(--ease-drawer) 0.1s both;
    }
    .nav-pill :global(.logo-star) {
      animation: star-in 1.6s var(--ease-drawer) 0.2s both;
    }
  }
  /* Sister-brand chip: lit by the Academy's Tropical sunrise. */
  .academy-chip {
    position: relative;
    isolation: isolate;
    color: var(--color-ink);
    background: linear-gradient(135deg, #ffc8e4, #ffdcb8 50%, #c4f7e1);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.7),
      0 0 0 1px rgb(255 255 255 / 0.35),
      0 6px 22px -6px rgb(255 196 140 / 0.7);
    transition: box-shadow 0.4s var(--ease-out-soft);
  }
  .academy-chip:hover {
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.7),
      0 0 0 1px rgb(255 255 255 / 0.5),
      0 8px 30px -4px rgb(255 158 210 / 0.8);
  }
  @media (prefers-reduced-motion: no-preference) {
    .academy-chip::after {
      content: "";
      position: absolute;
      inset: 0;
      z-index: -1;
      border-radius: inherit;
      background: linear-gradient(110deg, transparent 30%, rgb(255 255 255 / 0.75) 50%, transparent 70%);
      background-size: 250% 100%;
      animation: chip-shine 4.5s var(--ease-in-out-strong) infinite;
    }
  }
  /* Academy -> agency chip: Cosmos with an Aurora edge. */
  .sister-chip {
    position: relative;
    isolation: isolate;
    color: var(--color-shell);
    background: var(--color-ink);
    box-shadow:
      inset 0 0 0 1px rgb(195 168 255 / 0.45),
      0 8px 24px -8px rgb(143 211 255 / 0.55),
      0 4px 18px -6px rgb(255 158 210 / 0.45);
    transition: box-shadow 0.4s var(--ease-out-soft);
  }
  .sister-chip:hover {
    box-shadow:
      inset 0 0 0 1px rgb(195 168 255 / 0.7),
      0 10px 30px -6px rgb(143 211 255 / 0.7),
      0 6px 24px -6px rgb(255 158 210 / 0.6);
  }
  @media (prefers-reduced-motion: no-preference) {
    .sister-chip::after {
      content: "";
      position: absolute;
      inset: 0;
      z-index: -1;
      border-radius: inherit;
      background: linear-gradient(110deg, transparent 30%, rgb(195 168 255 / 0.35) 50%, transparent 70%);
      background-size: 250% 100%;
      animation: chip-shine 4.5s var(--ease-in-out-strong) infinite;
    }
  }
  @keyframes chip-shine {
    0%, 60% { background-position: 120% 0; }
    100% { background-position: -120% 0; }
  }
  @keyframes pill-in {
    from {
      opacity: 0;
      transform: translateY(-18px) scale(0.96);
      filter: blur(8px);
    }
  }
  @keyframes star-in {
    from {
      opacity: 0;
      transform: rotate(-180deg) scale(0.4);
    }
  }
  :global(html[data-menu="open"]) #menu-toggle .bar:first-child {
    transform: rotate(45deg);
  }
  :global(html[data-menu="open"]) #menu-toggle .bar:last-child {
    transform: rotate(-45deg);
  }
  :global(html[data-menu="open"]) #menu-overlay {
    visibility: visible;
    opacity: 1;
  }
  .menu-link span {
    transform: translateY(110%);
    transition: transform 0.8s var(--ease-drawer);
    transition-delay: calc(var(--i) * 60ms + 80ms);
  }
  :global(html[data-menu="open"]) .menu-link span {
    transform: none;
  }
</style>

<script>
  const root = document.documentElement;
  const toggle = document.getElementById("menu-toggle");
  const overlay = document.getElementById("menu-overlay");

  const setOpen = (open: boolean) => {
    root.dataset.menu = open ? "open" : "closed";
    toggle?.setAttribute("aria-expanded", String(open));
    toggle?.setAttribute("aria-label", (open ? toggle.dataset.closeLabel : toggle.dataset.openLabel) ?? "");
    const lenis = (window as unknown as { lenis?: { stop(): void; start(): void } }).lenis;
    open ? lenis?.stop() : lenis?.start();
    document.body.style.overflow = open ? "hidden" : "";
  };

  toggle?.addEventListener("click", () => setOpen(root.dataset.menu !== "open"));
  overlay?.querySelectorAll("a").forEach((a) => a.addEventListener("click", () => setOpen(false)));
  document.addEventListener("keydown", (e) => e.key === "Escape" && setOpen(false));
</script>
