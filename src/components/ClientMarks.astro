---
// Client strip: real clients only, each with its own square logo tile. Add a client here once they approve showing their logo.
import { Image } from "astro:assets";
import retreatSounds from "../assets/work/retreat-sounds-icon.png";
import freelanceNavigator from "../assets/work/freelance-navigator-logo.jpg";
import growAi from "../assets/work/grow-ai-logo.png";
import dialogueLabs from "../assets/work/dialogue-labs-logo.png";
import lawai from "../assets/work/lawai-logo.png";

interface Props {
  label?: string;
}
const { label = "Trusted by teams around the world" } = Astro.props;

const clients = [
  { name: "GROW AI", logo: growAi },
  { name: "Freelance Navigator", logo: freelanceNavigator },
  { name: "Retreat Sounds", logo: retreatSounds },
  { name: "Dialogue Labs", logo: dialogueLabs },
  { name: "LawAI", logo: lawai },
];
---

<div>
  <p class="text-center text-caption text-cosmos-muted">{label}</p>
  <ul class="mt-8 flex flex-wrap items-center justify-center gap-x-10 gap-y-6">
    {
      clients.map((c, i) => (
        <li data-reveal style={`--i:${i}`} class="flex items-center gap-3">
          <Image src={c.logo} alt="" width={40} height={40} densities={[1, 2]} class="size-10 rounded-[0.75rem] object-cover shadow-[0_0_0_1px_var(--c-line)]" />
          <span class="whitespace-nowrap text-[1.0625rem] font-semibold tracking-[-0.01em]">{c.name}</span>
        </li>
      ))
    }
  </ul>
</div>
