---
import { Icon } from "astro-icon/components";
import Logo from "./Logo.astro";
import { newTab } from "../lib/links";
import { site } from "../data/site";

const year = new Date().getFullYear();
const company = [...site.nav, { label: "Contact", href: "/contact" }];
---

<footer class="relative overflow-hidden border-t border-line">
  <div class="mx-auto max-w-7xl px-4 pt-20 sm:px-6 lg:px-10 lg:pt-28">

    <!-- Brand and links -->
    <div class="grid gap-12 pb-14 md:grid-cols-[1.3fr_0.7fr] md:items-start">
      <div class="max-w-xs">
        <Logo />
        <p class="mt-5 text-cosmos-muted">We find the work worth automating, build the systems, and train your team until AI becomes habit.</p>
        <a href={site.linkedin} {...newTab(site.linkedin)} class="group mt-6 inline-flex items-center gap-3 rounded-full py-2 pl-2 pr-4 shadow-[inset_0_0_0_1px_var(--c-line)] transition-colors duration-300 hover:bg-nacre">
          <span class="inline-flex size-8 items-center justify-center rounded-full bg-nacre"><Icon name="ph:linkedin-logo-light" class="size-4" /></span>
          <span class="text-[0.9375rem] font-medium">Follow Riverius AI on LinkedIn</span>
        </a>
      </div>

      <nav aria-label="Footer">
        <p class="text-caption text-cosmos-muted">Company</p>
        <ul class="mt-5 space-y-3">
          {company.map((item) => (
            <li><a href={item.href} class="transition-opacity hover:opacity-60">{item.label}</a></li>
          ))}
        </ul>
      </nav>

    </div>

    <p class="border-t border-line pt-8 text-caption text-cosmos-muted">© {year} Riverius AI. All rights reserved.</p>
  </div>

  <!-- Oversized wordmark with a pearl sheen. -->
  <p
    aria-hidden="true"
    class="wordmark pointer-events-none mt-10 select-none whitespace-nowrap text-center text-[22vw] font-semibold leading-[0.78] tracking-[-0.06em]"
  >
    Riverius
  </p>
</footer>

<style>
  .wordmark {
    background: linear-gradient(180deg, color-mix(in oklab, var(--c-cosmos) 9%, transparent), transparent 85%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    margin-bottom: -0.12em;
  }
</style>
