---
import { Icon } from "astro-icon/components";
import Logo from "./Logo.astro";
import { site } from "../data/site";

const year = new Date().getFullYear();
const company = [...site.nav.filter((i) => !("highlight" in i)), { label: "Contact", href: "/contact" }];
---

<footer class="relative overflow-hidden border-t border-line">
  <div class="mx-auto max-w-7xl px-4 pt-20 sm:px-6 lg:px-10 lg:pt-28">

    <!-- Brand, links, academy -->
    <div class="grid gap-12 pb-14 md:grid-cols-[1.3fr_0.7fr_1.2fr] md:items-start">
      <div class="max-w-xs">
        <Logo />
        <p class="mt-5 text-cosmos-muted">We find the work worth automating, build the systems, and train your team until AI becomes habit.</p>
        <a href={`mailto:${site.email}`} class="mt-6 inline-block font-medium underline decoration-line underline-offset-[6px] transition-colors hover:decoration-cosmos">
          {site.email}
        </a>
      </div>

      <nav aria-label="Footer">
        <p class="text-caption text-cosmos-muted">Company</p>
        <ul class="mt-5 space-y-3">
          {company.map((item) => (
            <li><a href={item.href} class="transition-opacity hover:opacity-60">{item.label}</a></li>
          ))}
        </ul>
      </nav>

      <a href="/academy" class="footer-academy group relative isolate block overflow-hidden rounded-[var(--radius-lg)] p-6 text-ink">
        <span class="block text-caption font-medium opacity-70">Want to learn AI yourself?</span>
        <span class="mt-2 flex items-center justify-between gap-4 text-subheading font-semibold">
          Riverius AI Academy
          <span class="inline-flex size-9 shrink-0 items-center justify-center rounded-full bg-ink/10 transition-transform duration-500 ease-[var(--ease-drawer)] group-hover:-translate-y-0.5 group-hover:translate-x-0.5">
            <Icon name="ph:arrow-up-right" class="size-4" />
          </span>
        </span>
        <span class="mt-1 block text-caption opacity-70">No-code AI courses and community, in Spanish.</span>
      </a>
    </div>

    <p class="border-t border-line pt-8 text-caption text-cosmos-muted">© {year} Riverius AI. All rights reserved.</p>
  </div>

  <!-- Oversized wordmark with a pearl sheen. -->
  <p
    aria-hidden="true"
    class="wordmark pointer-events-none mt-10 select-none whitespace-nowrap text-center text-[22vw] font-semibold leading-[0.78] tracking-[-0.06em]"
  >
    Riverius
  </p>
</footer>

<style>
  .wordmark {
    background: linear-gradient(180deg, color-mix(in oklab, var(--c-cosmos) 9%, transparent), transparent 85%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    margin-bottom: -0.12em;
  }
  .footer-academy {
    background: linear-gradient(135deg, #ffc8e4, #ffdcb8 50%, #c4f7e1);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.7),
      0 24px 60px -30px rgb(255 196 140 / 0.7);
    transition: box-shadow 0.5s var(--ease-out-soft);
  }
  .footer-academy:hover {
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.7),
      0 28px 70px -24px rgb(255 158 210 / 0.8);
  }
</style>
