---
import { Image } from "astro:assets";
import Words from "../Words.astro";
import { testimonialShots } from "../../data/academy";
const shots = [...testimonialShots, ...testimonialShots];
---

<section class="py-24 lg:py-32" aria-labelledby="shots-title">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-10">
    <h2 id="shots-title" class="display-lg max-w-[18ch]"><Words text="Y lo que nos escriben por WhatsApp." /></h2>
  </div>
  <div class="shots mt-14 overflow-hidden [mask-image:linear-gradient(90deg,transparent,#000_8%,#000_92%,transparent)]">
    <ul class="shots-track flex w-max gap-4 pr-4">
      {
        shots.map((src, i) => (
          <li class="bezel shrink-0" aria-hidden={i >= testimonialShots.length ? "true" : undefined}>
            <Image
              src={src}
              alt="Mensaje de un estudiante por WhatsApp"
              widths={[304, 368, 736]}
              sizes="(min-width: 640px) 368px, 304px"
              class="h-[380px] w-auto rounded-[var(--radius-lg)] object-cover sm:h-[460px]"
            />
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  @media (prefers-reduced-motion: no-preference) {
    .shots-track {
      animation: shots 70s linear infinite;
    }
    .shots:hover .shots-track {
      animation-play-state: paused;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .shots {
      overflow-x: auto;
    }
  }
  @keyframes shots {
    to {
      transform: translateX(-50%);
    }
  }
</style>
