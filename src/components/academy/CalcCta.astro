---
// Banner that sends visitors to the repetitive-work calculator.
import { Icon } from "astro-icon/components";

interface Props {
  text: string;
  label: string;
  class?: string;
}
const { text, label, class: className = "" } = Astro.props;
---

<section class:list={["px-3 sm:px-6 lg:px-10", className]}>
  <div data-reveal class="bezel mx-auto max-w-4xl">
    <div class="bezel-core is-pearl relative flex flex-col gap-6 overflow-hidden p-6 sm:flex-row sm:items-center sm:gap-8 sm:p-8">
      <div class="glow sunrise -right-[10%] -top-[70%] -z-10 size-[55%] !opacity-35" />
      <span class="calc-badge inline-flex size-14 shrink-0 items-center justify-center rounded-full">
        <Icon name="ph:calculator-light" class="size-7" />
      </span>
      <p class="flex-1 text-subheading font-semibold">{text}</p>
      <a href="/academy/calculadora" class="btn btn-primary group shrink-0" data-magnetic>
        {label}
        <span class="btn-island" aria-hidden="true"><Icon name="ph:arrow-right" class="size-4" /></span>
      </a>
    </div>
  </div>
</section>

<style>
  .calc-badge {
    background: linear-gradient(135deg, #ffc8e4, #ffdcb8 50%, #c4f7e1);
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.8), 0 12px 30px -12px rgb(255 196 140 / 0.9);
    color: var(--color-ink);
  }
</style>
