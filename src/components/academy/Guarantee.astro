---
// The Mentoría guarantee, on its own so it can't be missed.
import { Icon } from "astro-icon/components";
import Words from "../Words.astro";
import { OFFER } from "../../data/academy-offer";
---

<section class="px-3 pb-24 sm:px-6 lg:px-10 lg:pb-36">
  <div class="sunrise-card mx-auto flex max-w-5xl flex-col gap-8 rounded-[calc(var(--radius-lg)+8px)] p-8 sm:flex-row sm:items-center sm:p-12 lg:gap-12 lg:p-16">
    <span class="inline-flex size-20 shrink-0 items-center justify-center rounded-full bg-pearl shadow-[inset_0_0_0_1px_var(--c-line)]">
      <Icon name="ph:shield-check-light" class="size-10" />
    </span>
    <div>
      <p class="text-caption font-medium uppercase tracking-[0.16em]">Garantía de la Mentoría</p>
      <h2 class="mt-3 text-heading font-semibold sm:text-[2rem] sm:leading-[2.5rem]"><Words text={OFFER.mentoria.guarantee} /></h2>
      <p data-reveal class="mt-4 text-[0.9375rem]">{OFFER.mentoria.guaranteeTerms}</p>
    </div>
  </div>
</section>
