---
import { Image } from "astro:assets";
import teaching from "../../assets/academy/teaching.webp";
import { Icon } from "astro-icon/components";
import Words from "../Words.astro";
import { howItWorks } from "../../data/academy";

const bento = ["lg:col-span-3 lg:row-span-2", "lg:col-span-3", "lg:col-span-3", "lg:col-span-3", "lg:col-span-3"];
---

<section class="px-3 sm:px-6 lg:px-10">
  <div class="pearl-sheen relative isolate mx-auto max-w-7xl overflow-hidden rounded-[calc(var(--radius-lg)+8px)] bg-nacre px-5 py-20 shadow-[inset_0_0_0_1px_var(--c-line)] sm:px-10 lg:px-16 lg:py-28">
    <div class="glow sunrise -right-[10%] -top-[30%] -z-10 size-[520px] !opacity-40"></div>
    <div class="max-w-3xl">
      <h2 class="display-lg"><Words text="En la Mentoría, todo es en vivo." /></h2>
      <p data-reveal class="mt-6 max-w-[48ch] text-cosmos-muted">Cada clase es una sesión privada contigo, sobre tu propio trabajo. En Premium avanzas con las clases en video y te destrabas en las sesiones grupales.</p>
    </div>

    <div class="mt-14 grid gap-4 lg:grid-cols-6 lg:grid-rows-[repeat(3,minmax(11rem,auto))]">
      {
        howItWorks.map((c, i) => (
          <div data-reveal style={`--i:${i}`} class:list={["bezel", bento[i]]}>
            <div class:list={["bezel-core is-pearl spotlight flex h-full flex-col p-7 sm:p-9", i === 0 && "!bg-transparent"]}>
              {i === 0 && (
                <>
                  <Image
                    src={teaching}
                    alt="Una sesión en vivo con estudiantes"
                    widths={[480, 720, 980]}
                    sizes="(min-width: 1280px) 520px, (min-width: 1024px) 42vw, calc(100vw - 76px)"
                    class="absolute inset-0 -z-20 size-full object-cover"
                  />
                  <div class="absolute inset-0 -z-10 bg-gradient-to-t from-[#1e1638]/85 via-[#1e1638]/30 to-transparent" />
                </>
              )}
              <div class="flex items-start justify-between gap-3">
                <span class:list={["inline-flex size-12 shrink-0 items-center justify-center rounded-full", i === 0 ? "bg-shell/15 text-shell backdrop-blur-md" : "bg-nacre"]}>
                  <Icon name={c.icon} class="size-6" />
                </span>
                <span class:list={["rounded-full px-3 py-1 text-caption font-medium", i === 0 ? "bg-ink/60 text-shell backdrop-blur-md" : "bg-nacre"]}>
                  <span class="sr-only">Incluido en: </span>{c.tier}
                </span>
              </div>
              <h3 class:list={["font-semibold", i === 0 ? "display-lg mt-auto max-w-[12ch] pt-10 text-shell" : "mt-10 text-subheading"]}>{c.title}</h3>
              <p class:list={["mt-2 max-w-[40ch]", i === 0 ? "text-haze" : "text-cosmos-muted"]}>{c.text}</p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
