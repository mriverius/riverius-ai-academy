---
import Words from "../Words.astro";
import VideoFacade from "./VideoFacade.astro";
import { projects, path as levels } from "../../data/academy";

interface Props {
  title?: string;
  text?: string;
}
const {
  title = "Proyectos finales, construidos por estudiantes.",
  text = "Cada nivel termina con un proyecto real que el estudiante defiende en vivo. Estos ya están funcionando.",
} = Astro.props;
---

<section id="proyectos" class="scroll-mt-24 px-3 pb-24 sm:px-6 lg:px-10 lg:pb-40">
  <div class="mx-auto max-w-7xl">
    <div class="px-1">
      <p data-reveal class="pill-tag">Galería de proyectos</p>
      <h2 class="display-lg mt-6 max-w-[18ch]"><Words text={title} /></h2>
      <p data-reveal class="mt-6 max-w-[48ch] text-cosmos-muted">{text}</p>
    </div>

    <div class="mt-14 grid gap-4 lg:grid-cols-2">
      {
        projects.map((pr, i) => (
          <article data-reveal style={`--i:${i}`} class:list={["bezel", i === 0 && "lg:col-span-2"]}>
            <div class:list={["bezel-core is-pearl h-full p-2.5", i === 0 && "lg:grid lg:grid-cols-[1.5fr_1fr] lg:items-center lg:gap-4"]}>
              <VideoFacade id={pr.wistia} title={`Proyecto de ${pr.name}: ${pr.title}`} />
              <div class="p-5 sm:p-7">
                <div class="flex flex-wrap items-center gap-2">
                  <span class="sunrise-pill rounded-full px-3 py-1 text-caption font-medium">Nivel {pr.level}: {levels[pr.level - 1]?.level}</span>
                  {pr.tags.map((t) => (
                    <span class="rounded-full bg-nacre px-3 py-1 text-caption">{t}</span>
                  ))}
                </div>
                <h3 class:list={["mt-5", i === 0 ? "text-heading" : "text-subheading font-semibold"]}>{pr.title}</h3>
                <p class="mt-3 text-cosmos-muted">{pr.text}</p>
                <p class="mt-5 text-caption font-medium">Por {pr.name}</p>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
