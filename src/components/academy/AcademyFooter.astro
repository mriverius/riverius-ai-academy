---
import { Icon } from "astro-icon/components";
import Logo from "../Logo.astro";
import { newTab } from "../../lib/links";
import { academy, skoolLink } from "../../data/academy";

const year = new Date().getFullYear();
---

<footer class="relative overflow-hidden border-t border-line">
  <div class="mx-auto grid max-w-7xl gap-12 px-4 pb-10 pt-20 sm:px-6 md:grid-cols-[1.6fr_1fr_1fr] lg:px-10">
    <div class="max-w-sm">
      <Logo suffix="AI Academy" href="/academy" />
      <p class="mt-5 text-cosmos-muted">IA práctica en español. Aprende a tu ritmo, con una comunidad que te acompaña.</p>
      <a href={academy.sister.href} target="_blank" rel="noopener" class="group mt-8 block rounded-[var(--radius-md)] bg-nacre p-5 transition-colors hover:bg-line/60">
        <span class="block text-caption text-cosmos-muted">¿Prefieres que lo implementemos por ti?</span>
        <span class="mt-1 inline-flex items-center gap-2 font-semibold">
          Conoce Riverius AI
          <Icon name="ph:arrow-up-right" class="size-4 transition-transform duration-500 ease-[var(--ease-drawer)] group-hover:-translate-y-0.5 group-hover:translate-x-0.5" />
        </span>
      </a>
    </div>

    <nav aria-label="Pie de página">
      <p class="text-caption text-cosmos-muted">Explora</p>
      <ul class="mt-5 space-y-3">
        {academy.nav.map((item) => (
          <li><a href={item.href} class="transition-opacity hover:opacity-60">{item.label}</a></li>
        ))}
        <li><a href="/academy/calculadora" class="transition-opacity hover:opacity-60">Calculadora</a></li>
        <li><a href={skoolLink(Astro.url.pathname)} {...newTab(academy.skool)} class="transition-opacity hover:opacity-60">Comunidad en Skool</a></li>
      </ul>
    </nav>

    <div>
      <p class="text-caption text-cosmos-muted">Síguenos</p>
      <ul class="mt-5 flex gap-2">
        {academy.social.map((s) => (
          <li>
            <a href={s.href} {...newTab(s.href)} aria-label={s.label} class="inline-flex size-11 items-center justify-center rounded-full shadow-[inset_0_0_0_1px_var(--c-line)] transition-colors duration-300 hover:bg-nacre">
              <Icon name={s.icon} class="size-5" />
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>

  <div class="mx-auto flex max-w-7xl flex-col gap-2 px-4 text-caption text-cosmos-muted sm:flex-row sm:justify-between sm:px-6 lg:px-10">
    <p>© {year} Riverius AI Academy. Todos los derechos reservados.</p>
  </div>

  <p aria-hidden="true" class="wordmark pointer-events-none mt-10 select-none whitespace-nowrap text-center text-[22vw] font-semibold leading-[0.78] tracking-[-0.06em]">
    Academy
  </p>
</footer>

<style>
  .wordmark {
    background: linear-gradient(180deg, color-mix(in oklab, var(--color-mango) 45%, transparent), transparent 85%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    margin-bottom: -0.12em;
    opacity: 0.6;
  }
</style>
