---
// The fork in the road: each visitor picks the path made for them.
import { Icon } from "astro-icon/components";
import Words from "../Words.astro";
import { avatars } from "../../data/academy";
---

<section id="caminos" class="scroll-mt-24 px-3 py-24 sm:px-6 lg:px-10 lg:py-36">
  <div class="mx-auto max-w-7xl">
    <div class="px-1 text-center">
      <p data-reveal class="pill-tag">Elige tu camino</p>
      <h2 class="display-lg mx-auto mt-6 max-w-[18ch]"><Words text="¿Qué quieres lograr con la IA?" /></h2>
      <p data-reveal class="mx-auto mt-6 max-w-[46ch] text-cosmos-muted">Tres caminos, uno para cada meta. Elige el tuyo y te mostramos el programa pensado para ti.</p>
    </div>

    <div class="mt-14 grid gap-4 lg:grid-cols-3">
      {
        avatars.map((a, i) => (
          <a href={a.href} data-reveal style={`--i:${i}`} class="path-card group bezel block">
            <div class="bezel-core is-pearl spotlight relative flex h-full flex-col p-7 sm:p-9">
              <div class:list={["path-glow glow -right-[25%] -top-[25%] -z-10 size-[80%]", `tone-${i}`]} />
              <div class="flex items-center justify-between">
                <span class="inline-flex size-14 items-center justify-center rounded-full bg-nacre shadow-[inset_0_0_0_1px_var(--c-line)] transition-transform duration-700 ease-[var(--ease-drawer)] group-hover:rotate-[-8deg] group-hover:scale-105">
                  <Icon name={a.icon} class="size-7" />
                </span>
                <span class="text-caption font-medium text-cosmos-muted">{a.who}</span>
              </div>
              <h3 class="mt-14 text-heading">{a.title}</h3>
              <p class="mt-3 text-cosmos-muted">{a.text}</p>
              <ul class="mt-6 space-y-2">
                {a.fit.map((f) => (
                  <li class="flex gap-2.5 text-[0.9375rem]">
                    <Icon name="ph:check-light" class="mt-1 size-4 shrink-0" />
                    {f}
                  </li>
                ))}
              </ul>
              <span class="mt-auto flex items-center justify-between gap-4 pt-10 font-medium">
                {a.cta}
                <span class="inline-flex size-11 items-center justify-center rounded-full bg-cosmos text-pearl transition-transform duration-500 ease-[var(--ease-drawer)] group-hover:translate-x-1 group-hover:-translate-y-0.5">
                  <Icon name="ph:arrow-up-right" class="size-4" />
                </span>
              </span>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  .path-card {
    transition: transform 0.7s var(--ease-drawer);
  }
  @media (hover: hover) and (pointer: fine) {
    .path-card:hover {
      transform: translateY(-6px);
    }
  }
  .path-glow {
    opacity: 0.35;
    transition: opacity 0.7s var(--ease-out-soft);
  }
  .path-card:hover .path-glow {
    opacity: 0.7;
  }
  .tone-0 { background: var(--color-pitahaya); }
  .tone-1 { background: var(--color-mango); }
  .tone-2 { background: var(--color-jade); }
</style>
