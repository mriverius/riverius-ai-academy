---
// Options and prices on /academy/mentoria: do it alone (Standard), the course (Premium) or the Mentoría (highlighted),
// side by side, with the Mentoría guarantee underneath. Every price, spot count and link comes from academy-offer.ts.
import { Icon } from "astro-icon/components";
import Words from "../Words.astro";
import { newTab } from "../../lib/links";
import { tiers, mentoriaPromise } from "../../data/academy";
import { OFFER, tracked, mentoriaPrice, mentoriaSpots } from "../../data/academy-offer";

const page = Astro.url.pathname;
const standardHref = tracked(OFFER.skoolUrl, page, "standard");
const premiumHref = OFFER.premium.checkoutUrl ?? tracked(OFFER.skoolUrl, page, "premium");
const callHref = OFFER.mentoria.checkoutUrl ?? tracked(OFFER.calUrl, page, "precio");
const premiumIncludes = OFFER.premium.guarantee ? [...tiers.premium.includes, `Garantía: ${OFFER.premium.guarantee}`] : tiers.premium.includes;
---

<section id="opciones" class="scroll-mt-24 px-3 py-24 sm:px-6 lg:px-10 lg:py-36">
  <div class="mx-auto max-w-7xl">
    <div class="px-1 text-center">
      <p data-reveal class="pill-tag">Opciones y precios</p>
      <h2 class="display-lg mx-auto mt-6 max-w-[16ch]"><Words text="Elige cómo quieres empezar." /></h2>
      <p data-reveal class="mx-auto mt-6 max-w-[46ch] text-cosmos-muted">Tres opciones, según cuánto acompañamiento quieres.</p>
    </div>

    <div class="mt-14 grid gap-4 lg:grid-cols-3 lg:gap-5">
      <!-- Standard: do it alone -->
      <article data-reveal style="--i:0" class="bezel h-full" aria-labelledby="tier-standard">
        <div class="bezel-core is-pearl flex h-full flex-col p-7 sm:p-9">
          <p class="text-caption font-medium text-cosmos-muted">Hacerlo solo</p>
          <h3 id="tier-standard" class="mt-2 text-heading">Standard</h3>
          <p class="mt-2 text-cosmos-muted">Acceso a la comunidad.</p>
          <p class="mt-6 text-heading font-semibold">Gratis</p>
          <ul class="mb-8 mt-6 space-y-3 text-[0.9375rem]">
            {tiers.standard.includes.map((item) => (
              <li class="flex gap-3"><Icon name="ph:check-light" class="mt-1 size-4 shrink-0" aria-hidden="true" />{item}</li>
            ))}
          </ul>
          <a href={standardHref} {...newTab(standardHref)} class="btn btn-ghost group mt-auto w-full justify-between" aria-label="Únete gratis a Standard en Skool">
            Únete gratis
            <span class="btn-island" aria-hidden="true"><Icon name="ph:arrow-up-right" class="size-4" /></span>
          </a>
        </div>
      </article>

      <!-- Premium: the course -->
      <article data-reveal style="--i:1" class="bezel h-full" aria-labelledby="tier-premium">
        <div class="bezel-core is-pearl flex h-full flex-col p-7 sm:p-9">
          <p class="text-caption font-medium text-cosmos-muted">El curso, a tu ritmo</p>
          <h3 id="tier-premium" class="mt-2 text-heading">Premium</h3>
          <p class="mt-2 text-cosmos-muted">{tiers.premium.for}</p>
          <p class="mt-6 flex items-baseline gap-1">
            <span class="text-heading font-semibold">${OFFER.premium.monthly}</span>
            <span class="text-cosmos-muted">/mes</span>
          </p>
          <p class="mt-1 text-caption text-cosmos-muted">o ${OFFER.premium.yearly}/año (2 meses gratis)</p>
          <!-- TODO: confirm the "100 horas" line -->
          <p class="mt-5 flex items-center gap-2.5 rounded-[var(--radius-md)] bg-nacre px-4 py-3 text-[0.9375rem]">
            <Icon name="ph:clock-light" class="size-5 shrink-0" aria-hidden="true" />
            Por tu cuenta, tardas unas 100 horas.
          </p>
          <ul class="mb-8 mt-6 space-y-3 text-[0.9375rem]">
            {premiumIncludes.map((item) => (
              <li class="flex gap-3"><Icon name="ph:check-light" class="mt-1 size-4 shrink-0" aria-hidden="true" />{item}</li>
            ))}
          </ul>
          <a href={premiumHref} {...newTab(premiumHref)} class="btn btn-ghost group mt-auto w-full justify-between" aria-label="Empieza con Premium en Skool">
            Empieza con Premium
            <span class="btn-island" aria-hidden="true"><Icon name="ph:arrow-up-right" class="size-4" /></span>
          </a>
        </div>
      </article>

      <!-- Mentoría: first on mobile, last (rightmost) on desktop. -->
      <article data-reveal style="--i:2" class="mentoria bezel sunrise order-first h-full lg:order-none" aria-labelledby="tier-mentoria">
        <div class="bezel-core is-pearl relative flex h-full flex-col p-7 sm:p-9">
          <div class="glow sunrise -right-[30%] -top-[20%] -z-10 size-[80%] !opacity-30"></div>
          <p class="text-caption font-medium text-cosmos-muted">Mentoría 1:1</p>
          <h3 id="tier-mentoria" class="mt-2 text-heading">{mentoriaPromise}</h3>
          <p class="mt-2 text-cosmos-muted">{tiers.mentoria.for}</p>
          {mentoriaPrice ? (
            <p class="mt-6 flex items-baseline gap-2">
              <span class="text-heading font-semibold">{mentoriaPrice}</span>
              <span class="text-caption text-cosmos-muted">USD, pago único</span>
            </p>
          ) : (
            <p class="mt-6 text-subheading font-semibold">Consulta el precio</p>
          )}
          <ul class="mt-6 space-y-3 text-[0.9375rem]">
            {tiers.mentoria.includes.map((item) => (
              <li class="flex gap-3"><Icon name="ph:check-light" class="mt-1 size-4 shrink-0" aria-hidden="true" />{item}</li>
            ))}
          </ul>
          <p class="mt-7 flex items-center gap-3 rounded-[var(--radius-md)] px-5 py-4 font-semibold shadow-[inset_0_0_0_1px_var(--c-line)]">
            <Icon name="ph:hourglass-medium-light" class="size-5 shrink-0" aria-hidden="true" />
            {mentoriaSpots}
          </p>
          <a href={callHref} {...newTab(callHref)} class="btn btn-primary group mt-7 w-full justify-between" data-magnetic>
            Agenda tu llamada gratis
            <span class="btn-island" aria-hidden="true"><Icon name="ph:arrow-up-right" class="size-4" /></span>
          </a>
          <p class="mt-4 text-center text-[0.9375rem] text-cosmos-muted">
            ¿Dudas? <a href={OFFER.whatsappUrl} class="font-medium text-cosmos underline underline-offset-4">Escríbenos por WhatsApp</a>
          </p>
        </div>
      </article>
    </div>

    <!-- Mentoría guarantee -->
    <div data-reveal class="sunrise-card mx-auto mt-5 flex max-w-5xl flex-col gap-6 rounded-[calc(var(--radius-lg)+8px)] p-7 sm:flex-row sm:items-center sm:p-10">
      <span class="inline-flex size-14 shrink-0 items-center justify-center rounded-full bg-pearl shadow-[inset_0_0_0_1px_var(--c-line)]">
        <Icon name="ph:shield-check-light" class="size-7" />
      </span>
      <div>
        <p class="text-caption font-medium uppercase tracking-[0.16em]">Garantía de la Mentoría</p>
        <h3 class="mt-3 text-subheading font-semibold">{OFFER.mentoria.guarantee}</h3>
        <p class="mt-3 text-caption">{OFFER.mentoria.guaranteeDetail}</p>
      </div>
    </div>
  </div>
</section>

<style>
  .mentoria {
    padding: 2px;
    border-radius: calc(var(--radius-lg) + 2px);
    box-shadow: 0 30px 80px -30px color-mix(in oklab, var(--color-pitahaya) 70%, transparent);
  }
</style>
