---
// Offer card: what's included, the guarantee, the scarcity note and a call to book. Price is optional.
import { Icon } from "astro-icon/components";
import { newTab } from "../../lib/links";

interface Props {
  title: string;
  promise?: string;
  price?: string;
  includes: string[];
  guarantee: string;
  scarcity: string;
  href: string;
}
const { title, promise, price, includes, guarantee, scarcity, href } = Astro.props;
---

<div data-reveal class="bezel">
  <div class="bezel-core is-pearl relative overflow-hidden p-8 sm:p-12">
    <div class="glow sunrise -right-[20%] -top-[30%] -z-10 size-[70%] !opacity-40"></div>
    <h3 class="text-heading">{title}</h3>
    {promise && <p class="mt-3 text-subheading font-semibold text-cosmos-muted">{promise}</p>}
    {price && (
      <p class="mt-6 flex items-baseline gap-2">
        <span class="text-heading font-semibold">{price}</span>
        <span class="text-caption text-cosmos-muted">USD, pago único</span>
      </p>
    )}
    <p class="mt-8 text-caption font-medium text-cosmos-muted">Incluye</p>
    <ul class="mt-4 space-y-3">
      {includes.map((item) => (
        <li class="flex gap-3">
          <Icon name="ph:check-light" class="mt-1 size-4 shrink-0" />
          <span>{item}</span>
        </li>
      ))}
    </ul>
    <div class="mt-8 flex gap-4 rounded-[var(--radius-md)] bg-nacre p-5 shadow-[inset_0_0_0_1px_var(--c-line)]">
      <Icon name="ph:shield-check-light" class="size-6 shrink-0" />
      <p><span class="font-semibold">Garantía.</span> {guarantee}</p>
    </div>
    <p class="mt-6 flex items-center gap-2 text-caption text-cosmos-muted">
      <Icon name="ph:hourglass-medium-light" class="size-4 shrink-0" />
      {scarcity}
    </p>
    <a href={href} {...newTab(href)} class="btn btn-primary group mt-8 w-full justify-between" data-magnetic>
      Agenda una llamada
      <span class="btn-island" aria-hidden="true"><Icon name="ph:arrow-up-right" class="size-4" /></span>
    </a>
  </div>
</div>
