---
// Small animated illustrations for each phase: ripples (identify),
// connecting structure (build), a blooming guaria (adopt).
interface Props {
  kind: "scan" | "build" | "bloom";
}
const { kind } = Astro.props;
const nodes = [
  [40, 50], [100, 30], [160, 50], [70, 100], [130, 100], [40, 150], [100, 170], [160, 150],
];
const links = [
  [0, 1], [1, 2], [0, 3], [1, 3], [1, 4], [2, 4], [3, 4], [3, 5], [3, 6], [4, 6], [4, 7], [5, 6], [6, 7],
];
---

<div class:list={["phase-visual relative aspect-square w-full", `pv-${kind}`]} aria-hidden="true">
  <div class="glow aurora left-[20%] top-[20%] size-[60%] !opacity-40"></div>
  <svg viewBox="0 0 200 200" class="relative size-full">
    {
      kind === "scan" && (
        <g fill="none" stroke="currentColor">
          {[28, 52, 76, 96].map((r, i) => (
            <circle class="ring" cx="100" cy="100" r={r} stroke-width="0.6" style={`--i:${i}`} opacity="0.35" />
          ))}
          <g class="sweep">
            <path d="M100 100 L100 4 A96 96 0 0 1 183 52 Z" fill="url(#sweep)" stroke="none" />
          </g>
          {[[142, 64], [58, 128], [120, 150], [70, 60]].map(([x, y], i) => (
            <circle class="ping" cx={x} cy={y} r="3" fill="#c3a8ff" stroke="none" style={`--i:${i}`} />
          ))}
          <defs>
            <linearGradient id="sweep" x1="0" y1="0" x2="1" y2="1">
              <stop offset="0" stop-color="#c3a8ff" stop-opacity="0" />
              <stop offset="1" stop-color="#c3a8ff" stop-opacity="0.45" />
            </linearGradient>
          </defs>
        </g>
      )
    }
    {
      kind === "build" && (
        <g>
          {links.map(([a, b], i) => (
            <line
              class="link"
              x1={nodes[a][0]} y1={nodes[a][1]} x2={nodes[b][0]} y2={nodes[b][1]}
              stroke="currentColor" stroke-width="0.7" opacity="0.45" pathLength="1" style={`--i:${i}`}
            />
          ))}
          {nodes.map(([x, y], i) => (
            <g class="node" style={`--i:${i}`}>
              <circle cx={x} cy={y} r="7" fill="var(--c-pearl)" stroke="currentColor" stroke-width="0.7" />
              <circle cx={x} cy={y} r="2.2" fill={i % 3 === 0 ? "#8fd3ff" : i % 3 === 1 ? "#c3a8ff" : "#ff9ed2"} />
            </g>
          ))}
        </g>
      )
    }
    {
      kind === "bloom" && (
        <g transform="translate(100 100)">
          {[0, 60, 120, 180, 240, 300].map((deg, i) => (
            <g transform={`rotate(${deg})`}>
              <ellipse
                class="petal" cx="0" cy="-38" rx="18" ry="38"
                fill={i % 2 ? "rgb(195 168 255 / 0.28)" : "rgb(255 158 210 / 0.22)"}
                stroke="currentColor" stroke-width="0.6" stroke-opacity="0.4" style={`--i:${i}`}
              />
            </g>
          ))}
          <circle r="10" fill="var(--c-pearl)" stroke="currentColor" stroke-width="0.6" stroke-opacity="0.5" />
          <path class="core" fill="currentColor" d="M0 -7C0.5 -2.9 2.9 -0.5 7 0C2.9 0.5 0.5 2.9 0 7C-0.5 2.9 -2.9 0.5 -7 0C-2.9 -0.5 -0.5 -2.9 0 -7Z" />
        </g>
      )
    }
  </svg>
</div>

<style>
  .phase-visual {
    color: var(--c-cosmos);
  }
  @media (prefers-reduced-motion: no-preference) {
    .sweep {
      transform-origin: 100px 100px;
      animation: rot 6s linear infinite;
    }
    .ring {
      transform-origin: 100px 100px;
      animation: breathe 4s var(--ease-in-out-strong) infinite;
      animation-delay: calc(var(--i) * 0.3s);
    }
    .ping {
      transform-box: fill-box;
      transform-origin: center;
      animation: ping 3s ease-out infinite;
      animation-delay: calc(var(--i) * 0.75s);
    }
    .link {
      stroke-dasharray: 1;
      stroke-dashoffset: 1;
      animation: draw 5s var(--ease-in-out-strong) infinite;
      animation-delay: calc(var(--i) * 0.12s);
    }
    .node {
      transform-box: fill-box;
      transform-origin: center;
      animation: pop 5s var(--ease-out-soft) infinite;
      animation-delay: calc(var(--i) * 0.15s);
    }
    .petal {
      transform-box: view-box;
      transform-origin: 0 0;
      animation: bloom 6s var(--ease-in-out-strong) infinite;
      animation-delay: calc(var(--i) * 0.12s);
    }
    .core {
      transform-box: fill-box;
      transform-origin: center;
      animation: rot 12s linear infinite;
    }
  }
  @keyframes rot { to { transform: rotate(360deg); } }
  @keyframes breathe { 0%, 100% { transform: scale(1); } 50% { transform: scale(1.04); } }
  @keyframes ping {
    0%, 70%, 100% { opacity: 0.25; transform: scale(0.8); }
    10% { opacity: 1; transform: scale(1.4); }
  }
  @keyframes draw {
    0% { stroke-dashoffset: 1; }
    40%, 80% { stroke-dashoffset: 0; }
    100% { stroke-dashoffset: -1; }
  }
  @keyframes pop {
    0%, 100% { transform: scale(0.85); opacity: 0.6; }
    30%, 80% { transform: scale(1); opacity: 1; }
  }
  @keyframes bloom {
    0%, 100% { transform: scale(0.55); }
    45%, 70% { transform: scale(1); }
  }
</style>
