---
import Shell from "./Shell.astro";
import Header from "../components/Header.astro";
import AcademyFooter from "../components/academy/AcademyFooter.astro";
import { academy, skoolLink } from "../data/academy";
import { academyOrganization, organization } from "../lib/schema";

interface Props {
  title?: string;
  description?: string;
  schema?: Record<string, unknown>[];
  noindex?: boolean;
}
const { title, description = academy.description, schema = [], noindex } = Astro.props;
const fullTitle = title ? `${title} | ${academy.name}` : `${academy.name} | IA práctica en español`;
---

<Shell
  title={fullTitle}
  description={description}
  siteName={academy.name}
  lang="es"
  favicon="/favicon-academy.svg"
  touchIcon="/apple-touch-icon-academy.png"
  theme="light"
  image={{ src: "/og/academy.jpg", alt: "Riverius AI Academy: IA práctica en español" }}
  schema={[academyOrganization(), organization(), ...schema]}
  noindex={noindex}
>
  <Header
    slot="header"
    nav={academy.nav}
    cta={{ ...academy.cta, href: skoolLink(Astro.url.pathname) }}
    suffix="AI Academy"
    home="/academy"
  />
  <slot />
  <AcademyFooter slot="footer" />
</Shell>
