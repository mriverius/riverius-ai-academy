---
// Document shell shared by the agency and the academy.
import "../styles/global.css";
import Analytics from "@vercel/analytics/astro";
import SpeedInsights from "@vercel/speed-insights/astro";
import { graph } from "../lib/schema";

interface Props {
  title: string;
  description: string;
  siteName: string;
  lang?: "en" | "es";
  favicon?: string;
  touchIcon: string;
  theme?: "dark" | "light";
  // Social share image (1200x630) in public/, with its alt text.
  image: { src: string; alt: string };
  schema?: Record<string, unknown>[];
  noindex?: boolean;
}
const { title, description, siteName, lang = "en", favicon = "/favicon.svg", touchIcon, theme, image, schema = [], noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const imageUrl = new URL(image.src, Astro.site);
---

<!doctype html>
<html lang={lang} data-theme={theme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <link rel="icon" href={favicon} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={touchIcon} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content={theme === "light" ? "#fffbf7" : "#1e1638"} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={lang === "es" ? "es_419" : "en_US"} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={image.alt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={image.alt} />
    {schema.length > 0 && <script type="application/ld+json" set:html={graph(schema)} />}
    <script is:inline>document.documentElement.classList.add("js");</script>
    <Analytics />
    <SpeedInsights />
  </head>
  <body class="min-h-[100dvh] overflow-x-clip">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-full focus:bg-action focus:px-4 focus:py-2 focus:text-on-action">
      {lang === "es" ? "Saltar al contenido" : "Skip to content"}
    </a>
    <slot name="header" />
    <main id="main">
      <slot />
    </main>
    <slot name="footer" />
    <div class="grain" aria-hidden="true"></div>

    <script>
      import "../scripts/motion";
    </script>
  </body>
</html>
